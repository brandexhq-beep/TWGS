---
// pages/about.astro — editorial story page with scroll-scrubbed timeline
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const timelineItems = [
  { year: '2020', title: 'The Idea', desc: 'Our founder, having experienced years of impersonal, fragmented travel planning firsthand, decided to build the company he always wished existed.' },
  { year: '2021', title: 'First Five Families', desc: 'Word of mouth brought the first guests. Each one returned with stories that felt personal and alive — not like standard tour packages.' },
  { year: '2022', title: 'Building the Team', desc: 'We recruited destination specialists, local partners and a small but deeply passionate operations team committed to getting every detail right.' },
  { year: '2023', title: 'International Expansion', desc: 'From Bali to the Maldives, Europe to Southeast Asia — we extended the same curation philosophy beyond India\'s borders.' },
  { year: '2024', title: '5,000 Wanderers', desc: 'We crossed the 5,000 traveller milestone with a 4.9 Google rating — not because we chased reviews, but because we obsessed over the experience.' },
  { year: 'Now', title: 'Your Turn', desc: 'Every enquiry still gets personal attention. Every itinerary is still handcrafted. The company has grown; the philosophy hasn\'t.' },
];

const teamMembers = [
  {
    name: 'Founder & Lead Planner',
    photo: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&q=80',
    quote: '"The best journeys are the ones where you forget to check your phone."',
    note: 'Placeholder — client to provide team details.',
  },
  {
    name: 'Head of International Travel',
    photo: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&q=80',
    quote: '"I\'ve visited every destination we recommend. That\'s not a policy, it\'s a personal commitment."',
    note: 'Placeholder — client to provide team details.',
  },
  {
    name: 'Domestic Experiences Lead',
    photo: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80',
    quote: '"India has enough extraordinary places to fill a hundred lifetimes. We\'re here to help you find yours."',
    note: 'Placeholder — client to provide team details.',
  },
];
---

<BaseLayout
  title={`Our Story | ${SITE.name}`}
  description="Learn the story behind The Man Wanders Globe — how a wanderer's frustration with impersonal travel planning became a company that crafts bespoke journeys for thousands of travellers."
>
  <!-- Hero -->
  <div class="relative overflow-hidden" style="min-height: 70vh; display: flex; align-items: flex-end;">
    <img
      src="https://images.unsplash.com/photo-1488085061387-422e29b40080?w=1920&q=85&auto=format"
      alt="A solo traveller looking out across a mountain valley at sunset"
      width="1920" height="1080"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
    />
    <div class="hero-overlay absolute inset-0"></div>
    <div class="container-site relative z-10 pb-16 pt-32">
      <span class="text-eyebrow block mb-4">Our Story</span>
      <h1 class="text-display-xl text-white max-w-3xl mb-6">
        Born from a<br/><em class="not-italic" style="color: var(--color-luxury);">wanderer's frustration.</em>
      </h1>
      <p class="text-body-lg text-white/70 max-w-lg">
        What started as one man's quest for authentic travel became a company built on one belief:
        the journey matters as much as the destination.
      </p>
    </div>
  </div>

  <!-- Story section -->
  <section class="section-padding bg-[var(--color-bg)]" aria-label="Company story">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7 prose-style">
          <span class="text-eyebrow block mb-4">How It Started</span>
          <h2 class="text-display-lg mb-6">Every great company begins with a problem that <em>someone actually cares about solving.</em></h2>
          <div class="space-y-5 text-body-lg text-[var(--color-text-secondary)] leading-relaxed">
            <p>
              Our founder returned from a trip across Rajasthan — a trip that should have been extraordinary
              but had been reduced to a rushed sequence of hotel lobbies, generic sightseeing buses
              and impersonal itineraries clearly designed for the average traveller. He wasn't the average traveller.
              <strong class="text-[var(--color-text-primary)]">You're probably not either.</strong>
            </p>
            <p>
              He started The Man Wanders Globe with a simple premise: what if a travel company treated
              every guest the way a good concierge at the world's best hotel treats a valued regular?
              Know your name. Know your preferences. Know which table you'd actually prefer.
            </p>
            <p>
              Today we serve thousands of travellers across the world — families, honeymooners,
              adventurers, corporate teams and solo wanderers. The scale has changed. The philosophy hasn't.
              Every enquiry still gets personal attention. Every itinerary is still handcrafted.
            </p>
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="sticky top-28 space-y-6">
            <img
              src="https://images.unsplash.com/photo-1501854140801-50d01698950b?w=600&q=80"
              alt="Mountain vista representing the spirit of wandering"
              width="600" height="750"
              loading="lazy"
              class="rounded-2xl w-full object-cover"
              style="aspect-ratio: 4/5;"
            />
            <div class="grid grid-cols-3 gap-3">
              {[
                { value: `${SITE.stats.yearsInBusiness}+`, label: 'Years' },
                { value: `${SITE.stats.destinationsCount}+`, label: 'Destinations' },
                { value: `${(SITE.stats.travellersServed / 1000).toFixed(1)}k+`, label: 'Travellers' },
              ].map((s) => (
                <div class="bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl p-4 text-center">
                  <p class="font-display text-2xl font-semibold text-[var(--color-accent)]">{s.value}</p>
                  <p class="text-caption text-[var(--color-text-secondary)] uppercase tracking-wider mt-0.5">{s.label}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section-padding bg-[var(--color-surface)]" aria-label="Company timeline">
    <div class="container-site">
      <span class="text-eyebrow block mb-4">Our Journey</span>
      <h2 class="text-display-lg mb-12 max-w-xl">From a <em>single idea</em> to thousands of journeys.</h2>

      <!-- Desktop horizontal timeline / Mobile vertical -->
      <div class="relative">
        <!-- Vertical line (mobile) / Horizontal (desktop via CSS) -->
        <div class="hidden md:block absolute left-0 right-0 top-8 h-px bg-[var(--color-border)]" aria-hidden="true">
          <div id="timeline-fill-line" class="h-full bg-[var(--color-accent)] w-0 transition-all duration-500"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-6 gap-8 md:gap-4">
          {timelineItems.map((item, i) => (
            <div class="relative timeline-node gsap-rise-hidden" data-node-index={i}>
              <!-- Year dot (desktop) -->
              <div
                class="hidden md:flex w-8 h-8 rounded-full border-2 border-[var(--color-border)] bg-[var(--color-surface)] items-center justify-center mx-auto mb-4 z-10 relative transition-all duration-500"
                id={`timeline-dot-${i}`}
                aria-hidden="true"
              >
                <div class="w-3 h-3 rounded-full bg-[var(--color-border)] transition-colors duration-300 timeline-inner-dot"></div>
              </div>
              <!-- Mobile dot -->
              <div class="flex md:hidden items-start gap-4">
                <div class="w-8 h-8 rounded-full bg-[var(--color-accent)] flex items-center justify-center text-white text-xs font-bold shrink-0 mt-0.5">
                  {i + 1}
                </div>
              </div>

              <div class="md:pt-0 pl-12 md:pl-0">
                <span class="text-eyebrow block mb-2">{item.year}</span>
                <h3 class="text-h3 mb-2">{item.title}</h3>
                <p class="text-body text-[var(--color-text-secondary)] text-sm leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Team section -->
  <section class="section-padding bg-[var(--color-bg)]" aria-label="Our team">
    <div class="container-site">
      <div class="text-center mb-12">
        <span class="text-eyebrow block mb-4">The People</span>
        <h2 class="text-display-lg">Travellers first.<br/><em>Planners by profession.</em></h2>
        <p class="text-body text-[var(--color-text-secondary)] mt-4 max-w-lg mx-auto">
          Every member of our team has personally visited the destinations they recommend.
          That's not a policy — it's a prerequisite.
        </p>
        <p class="text-caption text-[var(--color-text-secondary)] mt-2 italic">
          ⚠️ Placeholder — client to provide real team photos and bios before launch.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        {teamMembers.map((member) => (
          <div class="text-center group gsap-rise-hidden team-card">
            <div class="relative w-40 h-40 rounded-full overflow-hidden mx-auto mb-5 img-zoom-container border-4 border-[var(--color-surface)] shadow-lg">
              <img
                src={member.photo}
                alt={member.name}
                width="160" height="160"
                loading="lazy"
                class="w-full h-full object-cover img-zoom-target"
              />
            </div>
            <h3 class="text-h3 mb-2">{member.name}</h3>
            <p class="text-body text-[var(--color-text-secondary)] italic text-sm leading-relaxed max-w-xs mx-auto">{member.quote}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA section -->
  <section class="section-padding bg-[var(--color-accent)] relative overflow-hidden" aria-label="Plan your trip CTA">
    <div class="decorative-layer absolute -right-20 opacity-10" aria-hidden="true">
      <svg width="300" height="300" viewBox="0 0 300 300" fill="none">
        <circle cx="300" cy="150" r="200" stroke="white" stroke-width="1" fill="none"/>
      </svg>
    </div>
    <div class="container-site text-center relative z-10">
      <h2 class="text-display-lg text-white mb-4">Ready to wander?</h2>
      <p class="text-body-lg text-white/75 mb-8 max-w-md mx-auto">
        Let us craft your next journey. No templates. No defaults. Just a trip that feels like yours.
      </p>
      <a href="/#plan-my-trip" class="btn btn-ghost-light">
        <span>Plan My Trip</span>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Timeline nodes stagger
  const nodes = document.querySelectorAll('.timeline-node');
  const dots = document.querySelectorAll('.timeline-inner-dot');
  const fillLine = document.getElementById('timeline-fill-line');

  gsap.to(nodes, {
    opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', stagger: 0.1,
    scrollTrigger: { trigger: nodes[0], start: 'top 75%',
      onEnter: () => {
        dots.forEach((d, i) => {
          setTimeout(() => {
            (d as HTMLElement).style.background = 'var(--color-accent)';
            d.closest('[id]')?.setAttribute('style', 'border-color: var(--color-accent)');
          }, i * 200);
        });
        if (fillLine) {
          gsap.to(fillLine, { width: '100%', duration: 1.5, ease: 'power2.out', delay: 0.3 });
        }
      }
    },
  });

  const teamCards = document.querySelectorAll('.team-card');
  gsap.to(teamCards, {
    opacity: 1, y: 0, duration: 0.6, ease: 'power3.out', stagger: 0.1,
    scrollTrigger: { trigger: teamCards[0], start: 'top 80%' },
  });
</script>
