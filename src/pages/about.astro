---
// pages/about.astro — The Journey Behind TheMan WandersGlobe Tours
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const stats = [
  { value: `${SITE.stats.yearsInBusiness}+`, label: 'Years Experience', icon: '🏆' },
  { value: `${SITE.stats.destinationsCount}+`, label: 'Global Destinations', icon: '📍' },
  { value: `${(SITE.stats.travellersServed / 1000).toFixed(1)}k+`, label: 'Happy Wanderers', icon: '✈️' },
  { value: `${SITE.stats.averageRating} ★`, label: 'Guest Satisfaction', icon: '⭐' },
];

const offers = [
  {
    title: 'International Holidays',
    desc: 'Curated escapes across Europe, Asia, Africa, and the Americas.',
    icon: '✈️',
    tag: 'Global'
  },
  {
    title: 'Group Tours',
    desc: 'Fun, seamless group departures with experienced tour managers.',
    icon: '👥',
    tag: 'Community'
  },
  {
    title: 'Customized Trips',
    desc: 'Tailor-made itineraries designed around your pace & style.',
    icon: '🎨',
    tag: 'Bespoke'
  },
  {
    title: 'Family Holidays',
    desc: 'Safe, comfortable, and memorable experiences for all ages.',
    icon: '👨‍👩‍👧',
    tag: 'Family'
  },
  {
    title: 'Couple & Honeymoon Trips',
    desc: 'Romantic stays, private dinners, and unforgettable views.',
    icon: '💑',
    tag: 'Romance'
  },
  {
    title: 'Youth Travel',
    desc: 'Vibrant, high-energy exploration & budget-conscious adventures.',
    icon: '🎒',
    tag: 'Adventure'
  },
  {
    title: 'Destination Experiences',
    desc: 'Authentic local food tours, safaris, and cultural deep-dives.',
    icon: '🌟',
    tag: 'Culture'
  },
  {
    title: 'Corporate & Private Travel',
    desc: 'Executive MICE events, incentive retreats & private charters.',
    icon: '💼',
    tag: 'Corporate'
  }
];

const pillars = [
  {
    title: '100% Tailored Itineraries',
    desc: 'No generic templates. Every trip is crafted around your preferences, schedule, and travel aspirations.',
    icon: '💎'
  },
  {
    title: 'Trusted Local Partners',
    desc: 'We collaborate with vetted boutique hotels, licensed local guides, and top-tier transport operators.',
    icon: '🤝'
  },
  {
    title: '24/7 Travel Concierge',
    desc: 'Direct personal support from your dedicated travel manager before, during, and after your journey.',
    icon: '🛡️'
  },
  {
    title: 'Transparent & Fair Value',
    desc: 'Bespoke luxury experience without inflated hidden costs. Honest pricing guaranteed.',
    icon: '💰'
  }
];

const leadershipTeam = [
  {
    name: 'Chandan .s',
    role: 'Founder & Chief Executive',
    image: '/team/founder.webp',
    bio: 'Passionate globetrotter & industry visioner focused on building a trusted global travel community.',
    badge: 'Founder'
  },
  {
    name: 'Praveen Kumar',
    role: 'Chief of Technology & Head of International Sales',
    image: '/team/cto.webp',
    bio: 'Leading digital innovation, seamless booking platforms, and high-growth sales operations.',
    badge: 'Technology & Int. Sales'
  },
  {
    name: 'Shalini',
    role: 'Strategic Marketing Head',
    image: '/team/shalini.webp',
    bio: 'Driving strategic brand initiatives and marketing campaigns across global markets.',
    badge: 'Strategic Marketing'
  },
  {
    name: 'Harish Gowda',
    role: 'Inbound Sales Head',
    image: '/team/coo.webp',
    bio: 'Driving global partner operations, regional sales excellence, and guest experience quality.',
    badge: 'Inbound Sales'
  }
];
---

<BaseLayout
  title={`About Us — Bespoke Travel Agency | ${SITE.name}`}
  description="Discover the journey behind TheMan WandersGlobe Tours — our story, vision, mission, and the specialist team crafting bespoke domestic & international travel experiences across India."
>
  <!-- Hero Section -->
  <div class="relative pt-36 pb-24 bg-[var(--color-accent-secondary)] overflow-hidden">
    <div class="container-site relative z-10">
      <span class="text-eyebrow block mb-4 text-[var(--color-luxury)]">Our Heritage & Vision</span>
      <h1 class="text-display-xl text-white mb-6 max-w-4xl font-bold">
        The Journey Behind<br/>
        <em class="not-italic" style="color: var(--color-luxury);">TheMan WandersGlobe Tours.</em>
      </h1>
      <p class="text-body-lg text-white/80 max-w-2xl font-light leading-relaxed mb-6">
        Travel has always been more than just a journey — it is a way of learning, experiencing, and connecting deeply with the world.
      </p>
      <p class="text-xs text-white/60 mb-12 font-medium tracking-wide uppercase">
        A proud brand of {SITE.company.legalName}
      </p>

      <!-- Trust Stats Bar -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-8 border-t border-white/15">
        {stats.map((s) => (
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-5 border border-white/15 hover:border-[var(--color-luxury)]/50 transition-all duration-300">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xl">{s.icon}</span>
              <span class="text-2xl font-bold text-white font-display">{s.value}</span>
            </div>
            <span class="text-xs text-white/70 font-medium uppercase tracking-wider block">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Decorative background layer -->
    <div class="decorative-layer absolute -right-16 -top-16 opacity-10" aria-hidden="true">
      <svg width="550" height="550" viewBox="0 0 550 550" fill="none">
        <circle cx="275" cy="275" r="260" stroke="white" stroke-width="1"/>
        <circle cx="275" cy="275" r="180" stroke="white" stroke-width="0.5"/>
      </svg>
    </div>
  </div>

  <!-- Story Section -->
  <section class="section-padding bg-[var(--color-bg)]" aria-label="Founder's Story">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Story Text -->
        <div class="lg:col-span-7 space-y-6">
          <span class="text-eyebrow block">How It All Began</span>
          <h2 class="text-h2 text-slate-900 font-bold leading-tight">
            Travel became a part of my life <em class="not-italic text-[var(--color-accent)]">long before it became a business.</em>
          </h2>

          <div class="space-y-4 text-slate-600 text-body-lg leading-relaxed">
            <p>
              Over the years, I travelled to different countries, experienced new cultures, met people from different backgrounds, and discovered how much there is to learn beyond the usual tourist routes. Each trip gave me a better understanding of destinations and, more importantly, what makes a trip truly worthwhile.
            </p>
            <p>
              My curiosity led me further into the travel industry. I attended travel events, connected with destination specialists, and learned directly from experienced professionals across the industry. Those conversations and experiences gave me the confidence to turn a personal passion into a professional venture.
            </p>
            <p class="font-semibold text-slate-900 text-xl pt-2 border-l-4 border-[var(--color-luxury)] pl-4">
              That idea became TheMan WandersGlobe Tours & Travels.
            </p>
            <p>
              Today, we bring together first-hand travel knowledge, industry connections, and carefully selected partners to help people discover destinations with greater ease and confidence.
            </p>
          </div>
        </div>

        <!-- Visual Feature Card -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200/80 bg-white p-8 space-y-6 hover:shadow-luxury transition-all duration-500">
            <div class="w-14 h-14 rounded-2xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] flex items-center justify-center text-3xl font-bold">
              🌍
            </div>
            <h3 class="text-2xl font-bold text-slate-900">More Than a Package</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              We don't believe every traveller should receive the same itinerary.
            </p>
            <p class="text-slate-600 text-sm leading-relaxed">
              Some want adventure. Some want comfort. Some want to discover local culture, while others simply want time away with the people they love.
            </p>
            <p class="text-slate-600 text-sm leading-relaxed font-medium">
              That's why we focus on understanding how you want to travel before planning what you should see.
            </p>
            <div class="pt-5 border-t border-slate-100 flex flex-col gap-1 text-xs text-[var(--color-text-secondary)]">
              <span class="font-bold text-[var(--color-luxury)] uppercase tracking-wider">Registered Legal Entity</span>
              <span class="font-bold text-slate-900 text-sm">{SITE.company.legalName}</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Vision & Mission Grid -->
  <section class="section-padding bg-slate-900 text-white relative overflow-hidden" aria-label="Vision & Mission">
    <div class="container-site relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-eyebrow block mb-3 text-[var(--color-luxury)]">Guided By Purpose</span>
        <h2 class="text-display-lg text-white font-bold">Our Vision & Mission</h2>
        <p class="text-slate-400 mt-4">Building a trusted global travel community connecting wanderers with stories worth sharing.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Vision -->
        <div class="bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur-md hover:border-[var(--color-luxury)]/50 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-[var(--color-luxury)]/20 text-[var(--color-luxury)] flex items-center justify-center text-3xl mb-6">
              🔭
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">Our Vision</h3>
            <p class="text-slate-300 leading-relaxed text-body mb-4">
              To grow TheMan WandersGlobe into a global travel brand that people can trust when they want to discover somewhere new.
            </p>
            <p class="text-slate-300 leading-relaxed text-body mb-4">
              We aim to build a community of travellers who are curious about the world, open to new experiences, and willing to go beyond the familiar.
            </p>
          </div>
          <p class="text-slate-400 text-xs leading-relaxed pt-4 border-t border-white/10">
            As we grow, we want our reach to grow with us — bringing more destinations, better partnerships, and new ways of travelling to our community.
          </p>
        </div>

        <!-- Mission -->
        <div class="bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur-md hover:border-[var(--color-luxury)]/50 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-[var(--color-accent)]/40 text-white flex items-center justify-center text-3xl mb-6">
              🎯
            </div>
            <h3 class="text-2xl font-bold text-white mb-4">Our Mission</h3>
            <p class="text-slate-300 leading-relaxed text-body mb-4">
              To make travel easier to understand, easier to plan, and better suited to the person taking the trip.
            </p>
            <p class="text-slate-300 leading-relaxed text-body mb-4">
              We combine destination knowledge with reliable ground partners and practical planning to deliver trips that offer the right balance of experience, comfort, flexibility, and value.
            </p>
          </div>
          <p class="text-slate-400 text-xs leading-relaxed pt-4 border-t border-white/10">
            Whether you are travelling for the first time or planning your next adventure, our role is to take care of the details so you can focus on the destination.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Offer Portfolio Grid -->
  <section class="section-padding bg-[var(--color-bg)]" aria-label="What We Offer">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-eyebrow block mb-3">Comprehensive Services</span>
        <h2 class="text-display-lg font-bold text-slate-900">What We Offer</h2>
        <p class="text-slate-600 mt-3 text-body">From a short getaway to a journey across continents, we help you find the right way to travel.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {offers.map((item) => (
          <div class="group bg-white border border-slate-200/80 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:border-[var(--color-accent)] hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-3xl">{item.icon}</span>
                <span class="text-[10px] uppercase font-bold text-[var(--color-luxury)] bg-[var(--color-luxury)]/10 px-2.5 py-1 rounded-full">{item.tag}</span>
              </div>
              <h3 class="font-bold text-lg text-slate-900 group-hover:text-[var(--color-accent)] transition-colors mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 Pillars of Excellence -->
  <section class="section-padding bg-slate-100/70 border-y border-slate-200/80" aria-label="Why Choose Us">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-eyebrow block mb-3 text-[var(--color-luxury)]">Why Choose Us</span>
        <h2 class="text-display-lg text-slate-900 font-bold">Built On Trust & Excellence</h2>
        <p class="text-slate-600 mt-3">Why thousands of travelers choose TheMan WandersGlobe for their journey.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {pillars.map((p) => (
          <div class="bg-white rounded-3xl p-7 border border-slate-200/80 shadow-sm hover:shadow-lg transition-all">
            <div class="w-12 h-12 rounded-2xl bg-[var(--color-accent)]/10 flex items-center justify-center text-2xl mb-5">
              {p.icon}
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">{p.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Leadership Team -->
  <section class="section-padding bg-[var(--color-bg)]" aria-label="Leadership Team">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-eyebrow block mb-3">Meet The Leaders</span>
        <h2 class="text-display-lg text-slate-900 font-bold">Executive Leadership Team</h2>
        <p class="text-slate-600 mt-3">The visionaries and strategic minds driving TheMan WandersGlobe Tours & Travels.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {leadershipTeam.map((member) => (
          <div class="group bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-md hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 flex flex-col">
            <!-- Image Container -->
            <div class="relative aspect-[4/5] w-full overflow-hidden bg-slate-100">
              <img
                src={member.image}
                alt={`${member.name} — ${member.role}`}
                width="600"
                height="750"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>
              
              <!-- Badge -->
              <span class="absolute top-4 left-4 bg-white/95 backdrop-blur-md text-[var(--color-accent-secondary)] font-bold text-xs px-3.5 py-1.5 rounded-full shadow-sm border border-slate-200">
                {member.badge}
              </span>
            </div>

            <!-- Card Content -->
            <div class="p-6 flex flex-col flex-1 justify-between bg-white">
              <div>
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-[var(--color-accent)] transition-colors mb-1">
                  {member.name}
                </h3>
                <p class="text-xs font-bold text-[var(--color-luxury)] uppercase tracking-wider mb-3">
                  {member.role}
                </p>
                <p class="text-slate-600 text-xs leading-relaxed line-clamp-3">
                  {member.bio}
                </p>
              </div>

              <div class="pt-4 mt-6 border-t border-slate-100 flex items-center justify-between">
                <span class="text-[11px] font-semibold text-slate-400">TheMan WandersGlobe</span>
                <span class="text-xs font-bold text-[var(--color-accent)] group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  Executive Team &rarr;
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="section-padding bg-[var(--color-accent)] text-white relative overflow-hidden" aria-label="Start Your Journey">
    <div class="container-site text-center relative z-10">
      <h2 class="text-display-lg font-bold text-white mb-4">Travel Your Way. Worldwide.</h2>
      <p class="text-body-lg text-white/80 max-w-xl mx-auto mb-8 font-light">
        From a short getaway to a journey across continents, we help you find the right way to travel.
      </p>
      <a href="/#plan-my-trip" class="btn btn-ghost-light px-8 py-3.5 rounded-full font-bold text-sm">
        <span>Plan Your Trip With Us</span>
      </a>
    </div>
  </section>
</BaseLayout>
