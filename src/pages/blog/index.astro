---
// pages/blog/index.astro — Blog & Editorial Hub
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import { BLOGS } from '../../data/blogs';
import { SITE } from '../../data/site';
import { getBreadcrumbSchema } from '../../lib/schema';

const breadcrumb = getBreadcrumbSchema(`${SITE.url}/blog`, [
  { name: "Home", url: `${SITE.url}/` },
  { name: "Blog & Travel Guides", url: `${SITE.url}/blog` },
]);

const categories = Array.from(new Set(BLOGS.map((b) => b.category)));
---

<BaseLayout
  title={`Travel Guides & Holiday Insights | ${SITE.name}`}
  description="Expert international travel advice, visa documentation guides, destination comparisons, and holiday planning tips from The Man Wanders Globe."
  structuredData={breadcrumb}
>
  <!-- Hero Section -->
  <header class="relative pt-36 pb-20 bg-[var(--color-accent-secondary)] overflow-hidden">
    <div class="decorative-layer absolute -right-16 top-0 opacity-10" aria-hidden="true">
      <svg width="400" height="400" viewBox="0 0 400 400" fill="none">
        <circle cx="400" cy="0" r="300" stroke="white" stroke-width="1" fill="none"/>
      </svg>
    </div>
    <div class="container-site relative z-10">
      <span class="text-eyebrow block mb-4 text-[var(--color-luxury)]">Editorial & Travel Intelligence</span>
      <h1 class="text-display-xl text-white mb-4">
        Insights, Guides &<br />
        <em class="not-italic text-[var(--color-luxury)]">Curated Travel Knowledge.</em>
      </h1>
      <p class="text-body-lg text-white/80 max-w-2xl font-light leading-relaxed">
        Everything you need to travel smarter — from visa walkthroughs and destination breakdowns to realistic cost blueprints and packing advice.
      </p>
    </div>
  </header>

  <!-- Blog Listing -->
  <section class="section-padding bg-[var(--color-bg)]" aria-label="Travel Articles and Guides">
    <div class="container-site">
      <!-- Category Badges -->
      <div class="flex flex-wrap gap-2 mb-12" role="navigation" aria-label="Article categories">
        <span class="px-4 py-1.5 rounded-full text-xs font-semibold bg-[#00277C] text-white">All Guides ({BLOGS.length})</span>
        {categories.map((cat) => (
          <span class="px-4 py-1.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 hover:bg-slate-200 transition-colors">
            {cat}
          </span>
        ))}
      </div>

      <!-- Grid of Articles -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {BLOGS.map((blog) => (
          <article class="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
            <a href={`/blog/${blog.slug}`} class="block relative aspect-[16/10] overflow-hidden bg-slate-100">
              <img
                src={blog.heroImage}
                alt={blog.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width="600"
                height="375"
              />
              <span class="absolute top-4 left-4 bg-white/90 backdrop-blur-md text-[#00277C] text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                {blog.category}
              </span>
            </a>

            <div class="p-6 flex-1 flex flex-col">
              <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
                <time datetime={blog.publishedDate}>
                  {new Date(blog.publishedDate).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                <span>•</span>
                <span>{blog.readingTime}</span>
              </div>

              <h2 class="text-xl font-bold text-slate-900 group-hover:text-[#00277C] transition-colors leading-snug mb-3">
                <a href={`/blog/${blog.slug}`}>
                  {blog.title}
                </a>
              </h2>

              <p class="text-slate-600 text-sm leading-relaxed mb-6 line-clamp-3 flex-1">
                {blog.summary}
              </p>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between mt-auto">
                <span class="text-xs font-medium text-slate-700">By {blog.author.name}</span>
                <a
                  href={`/blog/${blog.slug}`}
                  class="text-xs font-semibold text-[#00277C] hover:text-[#C6A34E] flex items-center gap-1 transition-colors"
                  aria-label={`Read ${blog.title}`}
                >
                  Read Guide
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
