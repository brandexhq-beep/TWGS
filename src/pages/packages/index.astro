---
// pages/packages/index.astro — packages landing with category tabs
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PACKAGES, PACKAGE_CATEGORIES } from '../../data/packages';
import { SITE } from '../../data/site';

const allPackages = PACKAGES;
---

<BaseLayout
  title={`Travel Packages — Domestic, International & Luxury | ${SITE.name}`}
  description="Browse our curated travel packages — honeymoon, family, adventure, luxury, corporate and solo trips across India and the world. Prices from ₹15,000 per person."
>
  <!-- Hero -->
  <div class="relative pt-32 pb-16 bg-[var(--color-accent-secondary)] overflow-hidden">
    <div class="container-site relative z-10">
      <span class="text-eyebrow block mb-4">All Packages</span>
      <h1 class="text-display-xl text-white mb-4">Curated journeys<br/><em class="not-italic" style="color: var(--color-luxury);">for every wanderer.</em></h1>
      <p class="text-body-lg text-white/70 max-w-lg">
        From a Goa weekend to a Maldives overwater escape — every package is crafted, not templated.
      </p>
    </div>
  </div>

  <section class="section-padding bg-[var(--color-bg)]" aria-label="Browse all travel packages">
    <div class="container-site">

      <!-- Category pill navigation -->
      <div class="flex flex-wrap gap-2 mb-10" role="tablist" aria-label="Package categories">
        {PACKAGE_CATEGORIES.map((cat, i) => (
          <button
            class="chip pkg-cat-btn"
            role="tab"
            data-category={cat.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            id={`tab-${cat.id}`}
            aria-controls="packages-panel"
            style={i === 0 ? 'border-color: var(--color-accent); color: var(--color-accent); background: rgba(29,92,75,0.06);' : ''}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Packages grid -->
      <div id="packages-panel" role="tabpanel" aria-label="Packages">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="packages-grid">
          {allPackages.map((pkg) => (
            <article
              class="pkg-card package-card gsap-rise-hidden"
              data-categories={pkg.category.join(',')}
            >
              <div class="card-image relative overflow-hidden" style="aspect-ratio: 4/3;">
                <img
                  src={pkg.heroImage}
                  alt={`${pkg.name} — ${pkg.destination}`}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
                <div class="absolute top-4 left-4">
                  <span class="chip bg-white/90 border-white text-[var(--color-text-primary)] text-xs" style="min-height:0; padding: 0.2rem 0.6rem; font-size: 0.7rem;">
                    {pkg.category[0].charAt(0).toUpperCase() + pkg.category[0].slice(1)}
                  </span>
                </div>
                <div class="absolute top-4 right-4 bg-[var(--color-accent)] text-white text-xs font-semibold px-3 py-1 rounded-full">
                  {pkg.duration.nights}N/{pkg.duration.days}D
                </div>
              </div>

              <div class="p-5">
                <p class="text-caption text-[var(--color-text-secondary)] mb-0.5">{pkg.destination}, {pkg.country}</p>
                <h3 class="text-h3 leading-snug mb-3">{pkg.name}</h3>

                <div class="flex items-center justify-between mb-4">
                  <div class="star-rating" aria-label={`${pkg.rating} stars`}>
                    {Array.from({length: 5}).map((_, i) => (
                      <span class="star" aria-hidden="true">{i < Math.floor(pkg.rating) ? '★' : '☆'}</span>
                    ))}
                    <span class="text-caption text-[var(--color-text-secondary)] ml-1">{pkg.rating} ({pkg.reviewCount})</span>
                  </div>
                  <div class="text-right">
                    <p class="text-caption text-[var(--color-text-secondary)]">From</p>
                    <p class="price-tag">₹{pkg.priceFrom.toLocaleString('en-IN')}</p>
                  </div>
                </div>

                <div class="flex gap-3">
                  <a href={`/packages/${pkg.slug}`} class="btn btn-primary flex-1 py-2.5 text-sm">
                    <span>View Details</span>
                  </a>
                  <a href="/#plan-my-trip" class="btn btn-secondary py-2.5 text-sm px-4">
                    <span>Enquire</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p id="pkg-no-results" class="hidden text-center text-[var(--color-text-secondary)] py-12">
          No packages in this category yet. <a href="/contact" class="text-[var(--color-accent)] animated-underline">Contact us</a> for a custom itinerary.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const tabs = document.querySelectorAll('.pkg-cat-btn');
  const cards = document.querySelectorAll('.pkg-card') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('pkg-no-results');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const cat = tab.getAttribute('data-category') ?? 'all';

      tabs.forEach((t) => {
        t.setAttribute('aria-selected', 'false');
        (t as HTMLElement).style.cssText = '';
      });
      tab.setAttribute('aria-selected', 'true');
      (tab as HTMLElement).style.cssText = 'border-color: var(--color-accent); color: var(--color-accent); background: rgba(29,92,75,0.06);';

      let visible = 0;
      cards.forEach((card) => {
        const cats = (card.getAttribute('data-categories') ?? '').split(',');
        const show = cat === 'all' || cats.includes(cat);
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (noResults) noResults.classList.toggle('hidden', visible > 0);
    });
  });

  gsap.to(cards, {
    opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', stagger: 0.06,
    scrollTrigger: { trigger: '#packages-grid', start: 'top 80%' },
  });
</script>
