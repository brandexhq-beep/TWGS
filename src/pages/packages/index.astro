---
// pages/packages/index.astro — packages landing with visual region cards & style sub-filters
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PACKAGES, PACKAGE_CATEGORIES } from '../../data/packages';
import { SITE } from '../../data/site';

const allPackages = PACKAGES;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
    { "@type": "ListItem", "position": 2, "name": "Packages", "item": `${SITE.url}/packages` },
  ]
};
---

<BaseLayout
  title={`Travel Packages | ${SITE.name}`}
  description="Browse curated travel packages — honeymoon, family, luxury, Europe, Maldives, Bali & more. Fully handled end-to-end."
  structuredData={breadcrumb}
>
  <!-- Hero -->
  <div class="relative pt-36 pb-16 bg-[var(--color-accent-secondary)] overflow-hidden">
    <div class="container-site relative z-10">
      <span class="text-eyebrow block mb-4">Curated Portfolios</span>
      <h1 class="text-display-xl text-white mb-4">Journeys crafted<br/><em class="not-italic" style="color: var(--color-luxury);">for every wanderer.</em></h1>
      <p class="text-body-lg text-white/70 max-w-lg">
        From European alpine dreams to tropical Asian escapes — every package is bespoke.
      </p>
    </div>
  </div>

  <section class="section-padding bg-[var(--color-bg)]" aria-label="Browse all travel packages">
    <div class="container-site">

      <!-- Explore by Destination (Pill Buttons) -->
      <div class="mb-10">
        <h2 class="text-xs uppercase tracking-widest text-[var(--color-text-secondary)] font-bold mb-4">Explore by Destination</h2>
        <div class="flex items-center gap-2 overflow-x-auto pb-4 scrollbar-none">
          {PACKAGE_CATEGORIES.filter(c => !["luxury", "family", "honeymoon", "international"].includes(c.id)).map((cat) => (
            <button 
              class={`region-card ${cat.id === 'all' ? 'active bg-[var(--color-accent)] text-white border-[var(--color-accent)]' : 'bg-white text-slate-700 border-slate-200'} px-5 py-2.5 rounded-full text-sm font-semibold border hover:border-[var(--color-accent)] transition-all shrink-0 whitespace-nowrap shadow-sm`}
              data-region={cat.id}
            >
              {cat.label}
            </button>
          ))}
        </div>
      </div>

      <!-- Travel Style Sub-Filter Chips -->
      <div class="flex items-center gap-2 mb-10 overflow-x-auto pb-2 scrollbar-none border-b border-slate-200/60">
        <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-text-secondary)] shrink-0 mr-2">Style:</span>
        <button class="style-chip active px-4 py-1.5 rounded-full text-xs font-semibold bg-[var(--color-accent)] text-white transition-colors" data-style="all">All Styles</button>
        <button class="style-chip px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:border-[var(--color-accent)] transition-colors" data-style="honeymoon">Honeymoon</button>
        <button class="style-chip px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:border-[var(--color-accent)] transition-colors" data-style="family">Family</button>
        <button class="style-chip px-4 py-1.5 rounded-full text-xs font-semibold bg-white text-slate-600 border border-slate-200 hover:border-[var(--color-accent)] transition-colors" data-style="adventure">Adventure</button>
      </div>

      <!-- Packages grid -->
      <div id="packages-panel" role="tabpanel" aria-label="Packages">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="packages-grid">
          {allPackages.map((pkg) => (
            <article
              class="pkg-card package-card relative group cursor-pointer"
              data-categories={pkg.category.join(',')}
              data-country={pkg.country}
            >
              <!-- Stretched link for full card clickability -->
              <a href={`/packages/${pkg.slug}`} class="absolute inset-0 z-10" aria-label={`View details for ${pkg.name}`}></a>
              
              <div class="card-image relative overflow-hidden" style="aspect-ratio: 4/3;">
                <img
                  src={pkg.heroImage}
                  alt={`${pkg.name} — ${pkg.destination}`}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute top-4 left-4 flex gap-1.5">
                  <span class="chip bg-white/90 border-white text-[var(--color-text-primary)] text-xs font-semibold" style="min-height:0; padding: 0.2rem 0.6rem; font-size: 0.7rem;">
                    {pkg.category.includes('europe') ? '🇪🇺 Europe' : pkg.category.includes('asia') ? '🌏 Asia' : pkg.category[0]}
                  </span>
                </div>
                <div class="absolute top-4 right-4 bg-[var(--color-accent)] text-white text-xs font-semibold px-3 py-1 rounded-full shadow">
                  {pkg.duration.nights}N/{pkg.duration.days}D
                </div>
              </div>

              <div class="p-6">
                <p class="text-caption text-[var(--color-text-secondary)] mb-1 font-medium">{pkg.destination}, {pkg.country}</p>
                <h3 class="text-xl font-bold font-serif leading-snug mb-3 text-[var(--color-text-primary)]">{pkg.name}</h3>

                <div class="flex items-center justify-between mb-4">
                  <div class="star-rating text-sm" aria-label={`${pkg.rating} stars`}>
                    <span class="text-[var(--color-luxury)]">★</span>
                    <span class="font-semibold text-[var(--color-text-primary)] ml-1">{pkg.rating}</span>
                    <span class="text-caption text-[var(--color-text-secondary)] ml-1">({pkg.reviewCount})</span>
                  </div>
                  <div class="text-right">
                    <p class="text-caption text-[var(--color-text-secondary)]">From</p>
                    <p class="price-tag text-lg font-serif">₹{pkg.priceFrom.toLocaleString('en-IN')}</p>
                  </div>
                </div>

                <div class="flex gap-3 pt-2 border-t border-slate-100">
                  <a href={`/packages/${pkg.slug}`} class="btn btn-primary flex-1 py-2.5 text-sm justify-center">
                    <span>View Details</span>
                  </a>
                  <a href="/#plan-my-trip" class="btn btn-secondary py-2.5 text-sm px-4 justify-center">
                    <span>Enquire</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <p id="pkg-no-results" class="hidden text-center text-[var(--color-text-secondary)] py-16 text-lg">
          No packages match your selected filter. <a href="/contact" class="text-[var(--color-accent)] font-semibold underline">Contact us</a> for a tailor-made itinerary!
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const regionCards = document.querySelectorAll('.region-card');
  const styleChips = document.querySelectorAll('.style-chip');
  const cards = document.querySelectorAll('.pkg-card') as NodeListOf<HTMLElement>;
  const noResults = document.getElementById('pkg-no-results');

  const urlParams = new URLSearchParams(window.location.search);
  let activeRegion = urlParams.get('region') ?? 'all';
  let activeStyle = urlParams.get('style') ?? 'all';
  let activeCountry = urlParams.get('country');

  function filterPackages() {
    let visible = 0;
    cards.forEach((card) => {
      const cats = (card.getAttribute('data-categories') ?? '').split(',');
      const country = card.getAttribute('data-country');
      // If region is set and not 'all', the package must have it
      const matchRegion = activeRegion === 'all' || cats.includes(activeRegion);
      // If style is set and not 'all', the package must have it
      const matchStyle = activeStyle === 'all' || cats.includes(activeStyle);
      const matchCountry = !activeCountry || country === activeCountry;
      const show = matchRegion && matchStyle && matchCountry;

      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    if (noResults) noResults.classList.toggle('hidden', visible > 0);
  }

  // Initial filter setup
  function updateUI() {
    // Update region buttons
    regionCards.forEach((c) => {
      if (c.getAttribute('data-region') === activeRegion) {
        c.classList.add('active', 'bg-[var(--color-accent)]', 'text-white', 'border-[var(--color-accent)]');
        c.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
      } else {
        c.classList.remove('active', 'bg-[var(--color-accent)]', 'text-white', 'border-[var(--color-accent)]');
        c.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
      }
    });

    // Update style chips
    styleChips.forEach((s) => {
      if (s.getAttribute('data-style') === activeStyle) {
        s.classList.add('bg-[var(--color-accent)]', 'text-white');
        s.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      } else {
        s.classList.remove('bg-[var(--color-accent)]', 'text-white');
        s.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      }
    });
    
    filterPackages();
  }
  
  updateUI();

  regionCards.forEach((btn) => {
    btn.addEventListener('click', () => {
      regionCards.forEach((c) => {
        c.classList.remove('active', 'bg-[var(--color-accent)]', 'text-white', 'border-[var(--color-accent)]');
        c.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
      });
      btn.classList.add('active', 'bg-[var(--color-accent)]', 'text-white', 'border-[var(--color-accent)]');
      btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');

      activeRegion = btn.getAttribute('data-region') ?? 'all';
      // When a region button is clicked, clear the URL country filter so it doesn't conflict
      activeCountry = null;
      const newUrl = new URL(window.location.href);
      newUrl.searchParams.delete('country');
      window.history.replaceState({}, '', newUrl);

      filterPackages();
    });
  });

  styleChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      styleChips.forEach((s) => {
        s.classList.remove('bg-[var(--color-accent)]', 'text-white');
        s.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });
      chip.classList.add('bg-[var(--color-accent)]', 'text-white');
      chip.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');

      activeStyle = chip.getAttribute('data-style') ?? 'all';
      filterPackages();
    });
  });

  gsap.from(cards, {
    opacity: 0, 
    y: 30, 
    duration: 0.8, 
    ease: 'power3.out', 
    stagger: 0.05,
    scrollTrigger: { trigger: '#packages-grid', start: 'top 85%' },
  });
</script>
