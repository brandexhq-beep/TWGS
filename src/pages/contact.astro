---
// pages/contact.astro — 2-column editorial layout
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title={`Contact Us | ${SITE.name}`}
  description="Get in touch with The Man Wanders Globe. Call, email, WhatsApp or visit us. Our travel specialists are here to help you plan your perfect journey."
>
  <!-- Page hero -->
  <div class="relative pt-32 pb-16 bg-[var(--color-accent-secondary)] overflow-hidden">
    <div class="decorative-layer absolute -right-16 top-0 opacity-10">
      <svg width="400" height="400" viewBox="0 0 400 400" fill="none" aria-hidden="true">
        <circle cx="400" cy="0" r="300" stroke="white" stroke-width="1" fill="none"/>
      </svg>
    </div>
    <div class="container-site relative z-10">
      <span class="text-eyebrow block mb-4">Get In Touch</span>
      <h1 class="text-display-xl text-white mb-4">Let's plan<br/><em class="not-italic" style="color: var(--color-luxury);">your journey.</em></h1>
      <p class="text-body-lg text-white/70 max-w-lg">
        Whether you have a dream destination in mind or need inspiration from scratch, we're here to help.
      </p>
    </div>
  </div>

  <section class="section-padding bg-[var(--color-bg)]" aria-label="Contact information and form">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">

        <!-- Left: contact cards + map -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Contact cards -->
          {[
            {
              icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.22h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
              label: 'Call Us',
              value: SITE.contact.phone,
              href: `tel:${SITE.contact.phone}`,
            },
            {
              icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
              label: 'Email Us',
              value: SITE.contact.email,
              href: `mailto:${SITE.contact.email}`,
            },
            {
              icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>`,
              label: 'WhatsApp Us',
              value: 'Chat now →',
              href: `https://wa.me/${SITE.contact.whatsapp}`,
              external: true,
            },
            {
              icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
              label: 'Visit Us',
              value: SITE.contact.address,
              href: '#map',
            },
          ].map((card) => (
            <a
              href={card.href}
              target={card.external ? '_blank' : '_self'}
              rel={card.external ? 'noopener noreferrer' : ''}
              class="flex items-start gap-4 p-5 bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)] card-hover group"
            >
              <div
                class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 text-[var(--color-accent)] transition-colors duration-200 group-hover:bg-[var(--color-accent)] group-hover:text-white"
                style="background: rgba(0,39,124,0.08);"
                set:html={card.icon}
              />
              <div>
                <p class="text-caption text-[var(--color-text-secondary)] mb-0.5">{card.label}</p>
                <p class="font-semibold text-[var(--color-text-primary)] text-sm leading-relaxed">{card.value}</p>
              </div>
            </a>
          ))}

          <!-- Business hours -->
          <div class="p-5 bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)]">
            <h3 class="font-semibold text-sm mb-3 text-[var(--color-text-primary)]">Business Hours</h3>
            <table class="w-full text-sm" aria-label="Business hours table">
              <tbody>
                <tr><td class="py-1 text-[var(--color-text-secondary)]">Monday – Saturday</td><td class="py-1 font-medium text-right">10:00 AM – 7:00 PM</td></tr>
                <tr><td class="py-1 text-[var(--color-text-secondary)]">Sunday</td><td class="py-1 font-medium text-right">Closed</td></tr>
                <tr><td class="py-1 text-[var(--color-text-secondary)]">Emergency</td><td class="py-1 font-medium text-right text-[var(--color-accent)]">WhatsApp 24/7</td></tr>
              </tbody>
            </table>
          </div>

          <!-- Map placeholder -->
          <div id="map" class="rounded-xl overflow-hidden border border-[var(--color-border)]" style="height: 220px;">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d241317.11609820923!2d72.74110211640032!3d19.08250908636604!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be7c6306644edc1%3A0x5da4ed8f8d648c69!2sMumbai%2C%20Maharashtra!5e0!3m2!1sen!2sin!4v1706000000000!5m2!1sen!2sin"
              width="100%"
              height="220"
              style="border: 0;"
              allowfullscreen={false}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Office location map"
            />
          </div>
        </div>

        <!-- Right: contact form -->
        <div class="lg:col-span-3">
          <h2 class="text-h2 mb-2">Send us a message.</h2>
          <p class="text-body text-[var(--color-text-secondary)] mb-8">We respond to every enquiry within one business day.</p>

          <div id="contact-form-state">
            <form id="contact-form" novalidate aria-label="Contact enquiry form" class="space-y-5">
              <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <input type="hidden" name="subject" value="Contact Enquiry — The Man Wanders Globe" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="form-field">
                  <label for="c-name" class="form-label">Full Name *</label>
                  <input type="text" id="c-name" name="name" class="form-input" placeholder="Raj Sharma" required autocomplete="name" />
                  <span class="form-error hidden" id="c-name-err">Please enter your name.</span>
                </div>
                <div class="form-field">
                  <label for="c-email" class="form-label">Email Address *</label>
                  <input type="email" id="c-email" name="email" class="form-input" placeholder="raj@example.com" required autocomplete="email" />
                  <span class="form-error hidden" id="c-email-err">Please enter a valid email.</span>
                </div>
              </div>

              <div class="form-field">
                <label for="c-phone" class="form-label">Phone Number</label>
                <input type="tel" id="c-phone" name="phone" class="form-input" placeholder="+91 98765 43210" autocomplete="tel" />
              </div>

              <div class="form-field">
                <label for="c-interest" class="form-label">Travel Interest *</label>
                <select id="c-interest" name="interest" class="form-input" required>
                  <option value="">Select your interest…</option>
                  <option>General Enquiry</option>
                  <option>Domestic Travel</option>
                  <option>International Travel</option>
                  <option>Honeymoon Planning</option>
                  <option>Family Holiday</option>
                  <option>Adventure Trip</option>
                  <option>Luxury Travel</option>
                  <option>Corporate / MICE</option>
                  <option>Solo Travel</option>
                </select>
                <span class="form-error hidden" id="c-interest-err">Please select an interest.</span>
              </div>

              <div class="form-field">
                <label for="c-message" class="form-label">Your Message *</label>
                <textarea id="c-message" name="message" class="form-input resize-none" rows={5} placeholder="Tell us about your dream trip — destination, dates, budget, special requirements…" required></textarea>
                <span class="form-error hidden" id="c-message-err">Please enter a message.</span>
              </div>

              <div>
                <label class="flex items-start gap-3 cursor-pointer">
                  <input type="checkbox" id="c-consent" name="consent" class="w-4 h-4 mt-0.5 accent-[#00277C]" required />
                  <span class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
                    I agree to the <a href="/privacy-policy" class="text-[var(--color-accent)] animated-underline">Privacy Policy</a>
                    and consent to being contacted about my enquiry.
                  </span>
                </label>
                <span class="form-error hidden" id="c-consent-err">Please agree to continue.</span>
              </div>

              <button type="submit" id="contact-submit" class="btn btn-primary w-full sm:w-auto">
                <span id="contact-btn-text">Send Message</span>
                <svg id="contact-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden animate-spin" aria-hidden="true">
                  <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
                </svg>
              </button>

              <p class="text-caption text-[var(--color-text-secondary)]">
                Your data is protected under the DPDP Act 2023. We will never sell or share your information.
              </p>
            </form>
          </div>

          <!-- Success state -->
          <div id="contact-success" class="hidden text-center py-12">
            <div class="flex justify-center mb-4">
              <svg width="64" height="64" viewBox="0 0 64 64" fill="none">
                <circle cx="32" cy="32" r="30" fill="rgba(0,39,124,0.1)" stroke="#00277C" stroke-width="2" id="contact-check-circle"/>
                <path d="M20 32 L28 40 L44 24" stroke="#00277C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" class="svg-check" id="contact-checkmark"/>
              </svg>
            </div>
            <h3 class="text-h2 mb-2">Message received!</h3>
            <p class="text-body text-[var(--color-text-secondary)] max-w-sm mx-auto">
              Thank you for reaching out. A specialist will reply to your enquiry within one business day.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const formState = document.getElementById('contact-form-state');
  const successState = document.getElementById('contact-success');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
  const btnText = document.getElementById('contact-btn-text');
  const spinner = document.getElementById('contact-spinner');

  function showErr(id: string, show: boolean) {
    document.getElementById(id)?.classList.toggle('hidden', !show);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const interest = (form.elements.namedItem('interest') as HTMLSelectElement).value;
    const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();
    const consent = (form.elements.namedItem('consent') as HTMLInputElement).checked;

    let valid = true;
    if (!name) { showErr('c-name-err', true); valid = false; } else showErr('c-name-err', false);
    if (!email || !email.includes('@')) { showErr('c-email-err', true); valid = false; } else showErr('c-email-err', false);
    if (!interest) { showErr('c-interest-err', true); valid = false; } else showErr('c-interest-err', false);
    if (!message) { showErr('c-message-err', true); valid = false; } else showErr('c-message-err', false);
    if (!consent) { showErr('c-consent-err', true); valid = false; } else showErr('c-consent-err', false);

    if (!valid) return;

    submitBtn.disabled = true;
    if (btnText) btnText.textContent = 'Sending…';
    spinner?.classList.remove('hidden');

    await new Promise(r => setTimeout(r, 1200)); // Demo delay

    formState?.classList.add('hidden');
    successState?.classList.remove('hidden');
    setTimeout(() => {
      document.getElementById('contact-check-circle')?.classList.add('animate');
      document.getElementById('contact-checkmark')?.classList.add('animate');
    }, 100);
  });
</script>
