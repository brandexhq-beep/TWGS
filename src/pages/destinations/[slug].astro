---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import { DESTINATIONS, getDestinationBySlug } from "../../data/destinations";
import { PACKAGES } from "../../data/packages";
import { SITE } from "../../data/site";

export async function getStaticPaths() {
  return DESTINATIONS.map((dest) => ({
    params: { slug: dest.slug },
  }));
}

const { slug } = Astro.params;
const destination = getDestinationBySlug(slug);

if (!destination) {
  return Astro.redirect("/destinations");
}

const packages = PACKAGES.filter((pkg) => {
  if (destination.slug === "europe") return pkg.category.includes("europe");
  if (destination.slug === "kashmir") return pkg.slug.includes("kashmir") || pkg.destination.toLowerCase().includes("kashmir");
  if (destination.slug === "himachal-pradesh") return pkg.slug.includes("manali") || pkg.slug.includes("shimla") || pkg.destination.toLowerCase().includes("himachal");
  if (destination.slug === "rajasthan") return pkg.slug.includes("rajasthan") || pkg.destination.toLowerCase().includes("rajasthan");
  
  return pkg.country.toLowerCase() === destination.packageCountry.toLowerCase() || 
         pkg.destination.toLowerCase().includes(destination.name.toLowerCase());
});

// Ensure ogImage is always a fully absolute URL
const ogImage = destination.heroImage.startsWith('http')
  ? destination.heroImage
  : `${SITE.url}${destination.heroImage}`;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE.url },
    { "@type": "ListItem", "position": 2, "name": "Destinations", "item": `${SITE.url}/destinations` },
    { "@type": "ListItem", "position": 3, "name": destination.name },
  ]
};

// Related: same region, exclude self, pick up to 3
const relatedDestinations = DESTINATIONS
  .filter((d) => d.slug !== destination.slug && d.region === destination.region)
  .slice(0, 3);
---

<BaseLayout
  title={`${destination.name} Packages | ${SITE.name}`}
  description={`Handpicked ${destination.name} travel packages from India. ${destination.tagline}. Book your trip today.`}
  ogImage={ogImage}
  structuredData={breadcrumb}
>
  <!-- Compact Hero Section -->
  <section class="relative pt-32 pb-16 flex items-end overflow-hidden">
    <img src={destination.heroImage} alt={destination.name} class="absolute inset-0 w-full h-full object-cover" width="1600" height="600" loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#00174A]/90 via-[#00174A]/60 to-black/30"></div>
    <div class="container-site relative z-10">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center gap-2 text-white/60 text-sm">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li>/</li>
          <li><a href="/destinations" class="hover:text-white transition-colors">Destinations</a></li>
          <li>/</li>
          <li class="text-white font-medium" aria-current="page">{destination.name}</li>
        </ol>
      </nav>
      <h1 class="text-white text-4xl md:text-5xl font-semibold leading-tight mb-2" style="font-family: var(--font-display);">{destination.name} Packages</h1>
      <p class="text-white/80 text-lg max-w-2xl">{destination.tagline}</p>
    </div>
  </section>

  <!-- Packages Section (Moved to top) -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="container-site">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-serif text-[var(--color-text-primary)]">Curated Itineraries for {destination.name}</h2>
        <span class="text-sm font-medium text-[var(--color-text-secondary)]">{packages.length} Packages</span>
      </div>
      
      {packages.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {packages.map((pkg) => (
            <article class="package-card relative group cursor-pointer flex flex-col">
              <a href={`/packages/${pkg.slug}`} class="absolute inset-0 z-10" aria-label={`View ${pkg.name} details`}></a>
              <div class="relative overflow-hidden" style="aspect-ratio: 4/3;"><img src={pkg.heroImage} alt={pkg.name} width="600" height="450" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" /><div class="absolute top-3 right-3 bg-[var(--color-accent)] text-white text-xs font-semibold px-2.5 py-1 rounded-full">{pkg.duration.nights}N/{pkg.duration.days}D</div></div>
              <div class="p-5 flex flex-col flex-1">
                <p class="text-xs text-[var(--color-text-secondary)] mb-1">{pkg.destination}</p>
                <h3 class="text-base font-semibold leading-snug mb-3" style="font-family: var(--font-display);">{pkg.name}</h3>
                <div class="mt-auto flex items-center justify-between"><div><p class="text-xs text-[var(--color-text-secondary)]">From</p><p class="price-tag text-lg"><span class="currency">&#x20B9;</span>{pkg.priceFrom.toLocaleString("en-IN")}</p></div><a href={`/packages/${pkg.slug}`} class="btn btn-primary py-2 px-4 text-xs relative z-20" aria-label={`Book now for ${pkg.name}`}><span>Book Now</span></a></div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="text-center py-12 bg-white rounded-2xl border border-[var(--color-border)]">
          <p class="text-[var(--color-text-secondary)] text-lg mb-6">No packages listed yet for {destination.name}.</p>
          <a href="/contact" class="btn btn-primary"><span>Request a Custom Itinerary</span></a>
        </div>
      )}
    </div>
  </section>

  <!-- Destination Info (Moved below packages) -->
  <section class="section-padding bg-[var(--color-surface)] border-t border-[var(--color-border)]">
    <div class="container-site">
      <SectionHeader eyebrow={`About ${destination.name}`} headline="Discover the Destination" subhead="Everything you need to know before you go." />
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 mt-10">
        <div class="lg:col-span-2">
          <p class="text-[var(--color-text-secondary)] text-lg leading-relaxed mb-8">{destination.description}</p>
          <h3 class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)] mb-4">Top Highlights</h3>
          <ul class="flex flex-wrap gap-3">{destination.highlights.map((h) => <li class="chip">{h}</li>)}</ul>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-[var(--color-border)] self-start shadow-sm">
          <h3 class="text-sm font-bold uppercase tracking-widest text-[var(--color-accent)] mb-5">Quick Facts</h3>
          <dl class="space-y-4">
            <div><dt class="text-xs text-[var(--color-text-secondary)] uppercase font-semibold tracking-wider mb-1">Duration</dt><dd class="font-semibold">{destination.duration.min}&#x2013;{destination.duration.max} days</dd></div>
            <div><dt class="text-xs text-[var(--color-text-secondary)] uppercase font-semibold tracking-wider mb-1">Budget From</dt><dd class="font-semibold text-[var(--color-accent)]">&#x20B9;{destination.budget.from.toLocaleString("en-IN")}</dd></div>
            <div><dt class="text-xs text-[var(--color-text-secondary)] uppercase font-semibold tracking-wider mb-1">Best Seasons</dt><dd class="font-semibold capitalize">{destination.seasons.join(", ")}</dd></div>
          </dl>
          <a href="/contact" class="btn btn-secondary w-full mt-6 justify-center"><span>Enquire Now</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-8 bg-[var(--color-bg)]">
    <div class="container-site">
      {relatedDestinations.length > 0 && (
        <div class="mb-10">
          <h2 class="text-h3 font-serif text-[var(--color-text-primary)] mb-1">You Might Also Like</h2>
          <p class="text-sm text-[var(--color-text-secondary)] mb-5">More handpicked destinations from The Man Wanders Globe</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedDestinations.map((rel) => (
              <a
                href={`/destinations/${rel.slug}`}
                class="group relative rounded-xl overflow-hidden aspect-[4/3] block"
              >
                <img
                  src={rel.heroImage}
                  alt={`${rel.name} travel packages from India`}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  width="400"
                  height="300"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-4">
                  <p class="text-white font-semibold text-base leading-tight">{rel.name}</p>
                  <p class="text-white/70 text-xs mt-0.5">{rel.tagline}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
      <a href="/destinations" class="inline-flex items-center gap-2 text-[var(--color-accent)] font-semibold hover:underline text-sm">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        Back to All Destinations
      </a>
    </div>
  </section>
</BaseLayout>