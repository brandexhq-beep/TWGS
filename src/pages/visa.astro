            <p class="text-xs text-neutral-600 mb-5 pb-4 border-b border-neutral-100 leading-relaxed">
              <strong class="text-neutral-800">Coverage:</strong> {visa.coverage}
            </p>

            <!-- Key Specs -->
            <div class="grid grid-cols-2 gap-3 mb-6 bg-neutral-100 p-3.5 rounded-2xl text-xs border border-neutral-200">
              <div>
                <span class="text-[10px] uppercase tracking-wider text-neutral-500 block font-bold mb-0.5">Processing</span>
                <span class="font-bold text-neutral-900">{visa.processingTime}</span>
              </div>
              <div>
                <span class="text-[10px] uppercase tracking-wider text-neutral-500 block font-bold mb-0.5">Validity</span>
                <span class="font-bold text-neutral-900">{visa.validity}</span>
              </div>
            </div>

            <!-- Highlights Checklist -->
            <ul class="space-y-2 mb-8 flex-1">
              {visa.highlights.map((item) => (
                <li class="flex items-start gap-2 text-xs text-neutral-600">
                  <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <!-- CTA -->
            <a 
              href={`https://wa.me/${SITE.contact.whatsapp}?text=${encodeURIComponent(`Hi, I would like to get visa assistance for ${visa.country}. Please share requirements and process.`)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full py-3 px-4 rounded-xl text-center font-semibold text-xs uppercase tracking-wider bg-[var(--color-accent)] hover:bg-[var(--color-accent-dark)] text-white transition-colors duration-200 shadow-sm flex items-center justify-center gap-2 mt-auto"
            >
              <span>Apply for {visa.country}</span>
              <span>&rarr;</span>
            </a>
          </div>
        ))}
      </div>

      <!-- No Results State -->
      <div id="visa-no-results" class="hidden text-center py-16 bg-white rounded-3xl border border-neutral-200 shadow-sm mt-6 p-8">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-neutral-100 flex items-center justify-center text-3xl">
          🔍
        </div>
        <h3 class="text-xl font-serif font-bold text-neutral-900 mb-2">No Matching Visa Destinations Found</h3>
        <p class="text-neutral-500 text-sm max-w-md mx-auto mb-6">
          We process visas for over 50+ countries worldwide even if not listed in this view. Contact our visa desk directly for immediate assistance.
        </p>
        <div class="flex justify-center gap-3">
          <button id="visa-empty-reset-btn" class="px-5 py-2.5 bg-neutral-100 hover:bg-neutral-200 text-neutral-800 text-xs font-bold rounded-xl transition-all">
            Clear Filters
          </button>
          <a 
            href={`https://wa.me/${SITE.contact.whatsapp}?text=${encodeURIComponent("Hi! I have a visa inquiry for a country not listed on your website. Could you please advise?")}`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="px-5 py-2.5 bg-[#C6A34E] hover:bg-[#B3913E] text-neutral-950 text-xs font-bold rounded-xl transition-all"
          >
            Consult on WhatsApp
          </a>
        </div>
      </div>

      <!-- Pagination Controls -->
      <div id="visa-pagination-container" class="flex items-center justify-center gap-2 mt-12 flex-wrap">
        <!-- Dynamically rendered pagination buttons -->
      </div>
    </div>
  </section>

  <!-- Client-Side Search, Fuzzy Matching, and Pagination Script -->
  <script>
    const ITEMS_PER_PAGE = 9;
    let currentPage = 1;
    let searchQuery = '';
    let selectedRegion = 'all';
    let selectedVisaType = 'all';
    let selectedSort = 'featured';

    const searchInput = document.getElementById('visa-search-input') as HTMLInputElement | null;
    const searchClear = document.getElementById('visa-search-clear');
    const typeSelect = document.getElementById('visa-type-select') as HTMLSelectElement | null;
    const sortSelect = document.getElementById('visa-sort-select') as HTMLSelectElement | null;
    const regionPills = document.querySelectorAll('.visa-region-pill');
    const resetAllBtn = document.getElementById('visa-reset-all-btn');
    const emptyResetBtn = document.getElementById('visa-empty-reset-btn');
    const countBadge = document.getElementById('visa-count-badge');
    const activeChipsContainer = document.getElementById('visa-active-chips');
    const visaGrid = document.getElementById('visa-grid');
    const noResults = document.getElementById('visa-no-results');
    const paginationContainer = document.getElementById('visa-pagination-container');

    const allCards = Array.from(document.querySelectorAll('.visa-card')) as HTMLElement[];

    // Fuzzy Search Helper: Handles typos, common aliases, transposed letters, and partial matches
    function calculateFuzzyScore(text: string, query: string): number {
      const t = text.toLowerCase();
      const q = query.toLowerCase().trim();
      if (!q) return 1;

      // Exact substring match gives highest score
      if (t.includes(q)) return 100;

      // Check common aliases and alternate spellings
      const aliasMap: Record<string, string[]> = {
        'combodia': ['cambodia'],
        'cambodia': ['combodia', 'siem reap', 'angkor'],
        'korea': ['south korea', 'north korea', 'seoul', 'pyongyang'],
        'south korea': ['korea', 'seoul', 'busan', 'k-eta'],
        'north korea': ['korea', 'dprk', 'pyongyang'],
        'bali': ['indonesia', 'denpasar', 'ubud'],
        'indonesia': ['bali', 'jakarta'],
        'america': ['united states', 'usa', 'us'],
        'usa': ['united states', 'america', 'b1', 'b2'],
        'uk': ['united kingdom', 'england', 'britain', 'london'],
        'uae': ['dubai', 'abu dhabi', 'emirates'],
        'dubai': ['uae', 'emirates'],
        'hong kong': ['macau', 'hk', 'par'],
        'macau': ['hong kong', 'macao'],
        'philippines': ['philippine', 'manila', 'boracay', 'cebu'],
        'philipines': ['philippines', 'manila'],
        'vietnam': ['viet nam', 'hanoi', 'da nang'],
        'sri lanka': ['srilanka', 'colombo'],
        'srilanka': ['sri lanka', 'colombo'],
        'schengen': ['europe', 'france', 'germany', 'italy', 'switzerland', 'spain'],
        'europe': ['schengen', 'uk', 'armenia', 'azerbaijan'],
        'saudi': ['saudi arabia', 'mecca', 'makkah', 'umrah'],
        'africa': ['south africa', 'cape town'],
      };

      for (const [key, aliases] of Object.entries(aliasMap)) {
        if (q.includes(key) || key.includes(q)) {
          if (aliases.some(a => t.includes(a)) || t.includes(key)) {
            return 80;
          }
        }
      }

      // Word-token matching
      const qTokens = q.split(/\s+/).filter(Boolean);
      let matchedTokens = 0;
      for (const token of qTokens) {
        if (t.includes(token)) {
          matchedTokens++;
          continue;
        }
        // Sub-sequence character check for typos (Levenshtein-like subsequence)
        let tIndex = 0;
        let charMatches = 0;
        for (let i = 0; i < token.length; i++) {
          const char = token[i];
          const foundIdx = t.indexOf(char, tIndex);
          if (foundIdx !== -1) {
            charMatches++;
            tIndex = foundIdx + 1;
          }
        }
        if (charMatches / token.length >= 0.75 && token.length >= 4) {
          matchedTokens += 0.8;
        }
      }

      return (matchedTokens / qTokens.length) * 50;
    }

    function syncRegionUI() {
      regionPills.forEach((pill) => {
        const r = pill.getAttribute('data-region');
        if (r === selectedRegion) {
          pill.className = 'visa-region-pill px-4 py-2 rounded-xl text-xs font-bold transition-all shrink-0 cursor-pointer bg-[#10253F] text-white shadow-sm';
        } else {
          pill.className = 'visa-region-pill px-4 py-2 rounded-xl text-xs font-bold transition-all shrink-0 cursor-pointer bg-neutral-100 text-neutral-600 hover:bg-neutral-200 hover:text-neutral-900';
        }
      });
    }

    function getFilteredAndSortedCards(): HTMLElement[] {
      const q = searchQuery.trim().toLowerCase();

      const matched = allCards.filter((card) => {
        const country = card.getAttribute('data-country') || '';
        const coverage = card.getAttribute('data-coverage') || '';
        const typeText = card.getAttribute('data-type-text') || '';
        const visaType = card.getAttribute('data-visa-type') || '';
        const region = card.getAttribute('data-region') || '';
        const highlights = card.getAttribute('data-highlights') || '';

        const fullSearchable = `${country} ${coverage} ${typeText} ${region} ${highlights}`;

        // Fuzzy search check
        let matchesSearch = true;
        if (q) {
          const score = calculateFuzzyScore(fullSearchable, q);
          matchesSearch = score >= 35;
        }

        // Region filter
        let matchesRegion = true;
        if (selectedRegion !== 'all') {
          matchesRegion = region === selectedRegion;
        }

        // Visa category filter
        let matchesVisaType = true;
        if (selectedVisaType !== 'all') {
          matchesVisaType = visaType === selectedVisaType;
        }

        return matchesSearch && matchesRegion && matchesVisaType;
      });

      // Sorting
      matched.sort((a, b) => {
        const isFeaturedA = a.getAttribute('data-featured') === 'true' ? 1 : 0;
        const isFeaturedB = b.getAttribute('data-featured') === 'true' ? 1 : 0;
        const countryA = (a.getAttribute('data-country') || '').toLowerCase();
        const countryB = (b.getAttribute('data-country') || '').toLowerCase();

        switch (selectedSort) {
          case 'name-asc':
            return countryA.localeCompare(countryB);
          case 'name-desc':
            return countryB.localeCompare(countryA);
          case 'featured':
          default:
            if (isFeaturedB !== isFeaturedA) {
              return isFeaturedB - isFeaturedA;
            }
            return parseInt(a.getAttribute('data-index') || '0', 10) - parseInt(b.getAttribute('data-index') || '0', 10);
        }
      });

      return matched;
    }

    function renderActiveChips() {
      if (!activeChipsContainer) return;
      activeChipsContainer.innerHTML = '';
      const chips: { label: string; clear: () => void }[] = [];

      if (searchQuery.trim()) {
        chips.push({
          label: `Search: "${searchQuery.trim()}"`,
          clear: () => {
            searchQuery = '';
            if (searchInput) searchInput.value = '';
            searchClear?.classList.add('hidden');
          }
        });
      }

      if (selectedRegion !== 'all') {
        const regObj = Array.from(regionPills).find(p => p.getAttribute('data-region') === selectedRegion);
        chips.push({
          label: `Region: ${regObj?.textContent?.trim() || selectedRegion}`,
          clear: () => {
            selectedRegion = 'all';
            syncRegionUI();
          }
        });
      }

      if (selectedVisaType !== 'all') {
        let typeName = selectedVisaType;
        if (selectedVisaType === 'evisa') typeName = 'eVisa / Online';
        if (selectedVisaType === 'sticker') typeName = 'Consular Sticker';
        if (selectedVisaType === 'voa') typeName = 'Visa on Arrival';
        chips.push({
          label: `Category: ${typeName}`,
          clear: () => {
            selectedVisaType = 'all';
            if (typeSelect) typeSelect.value = 'all';
          }
        });
      }

      chips.forEach((chip) => {
        const span = document.createElement('span');
        span.className = 'inline-flex items-center gap-1.5 px-3 py-1 bg-neutral-100 hover:bg-neutral-200 border border-neutral-300 rounded-full text-xs font-semibold text-neutral-800 shadow-sm transition-all';
        span.innerHTML = `<span>${chip.label}</span><button class="text-neutral-400 hover:text-neutral-900 font-bold ml-1 text-sm leading-none" aria-label="Remove filter">&times;</button>`;
        span.querySelector('button')?.addEventListener('click', () => {
          chip.clear();
          currentPage = 1;
          applyFilters();
        });
        activeChipsContainer.appendChild(span);
      });
    }

    function renderPagination(totalItems: number) {
      if (!paginationContainer) return;
      paginationContainer.innerHTML = '';
      const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

      if (totalPages <= 1) return;

      // Previous Button
      const prevBtn = document.createElement('button');
      prevBtn.className = `px-3.5 py-2 rounded-xl text-xs font-bold border transition-all ${
        currentPage === 1
          ? 'opacity-40 cursor-not-allowed border-neutral-200 text-neutral-400'
          : 'bg-white border-neutral-200 text-neutral-800 hover:border-[#C6A34E]'
      }`;
      prevBtn.innerHTML = '&larr; Prev';
      prevBtn.disabled = currentPage === 1;
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          applyFilters(true);
        }
      });
      paginationContainer.appendChild(prevBtn);

      // Numbered Page Buttons
      for (let i = 1; i <= totalPages; i++) {
        const pageBtn = document.createElement('button');
        pageBtn.className = `w-9 h-9 rounded-xl text-xs font-bold border transition-all ${
          currentPage === i
            ? 'bg-[#10253F] text-white border-[#10253F] shadow-sm'
            : 'bg-white border-neutral-200 text-neutral-700 hover:border-[#C6A34E]'
        }`;
        pageBtn.innerText = i.toString();
        pageBtn.addEventListener('click', () => {
          currentPage = i;
          applyFilters(true);
        });
        paginationContainer.appendChild(pageBtn);
      }

      // Next Button
      const nextBtn = document.createElement('button');
      nextBtn.className = `px-3.5 py-2 rounded-xl text-xs font-bold border transition-all ${
        currentPage === totalPages
          ? 'opacity-40 cursor-not-allowed border-neutral-200 text-neutral-400'
          : 'bg-white border-neutral-200 text-neutral-800 hover:border-[#C6A34E]'
      }`;
      nextBtn.innerHTML = 'Next &rarr;';
      nextBtn.disabled = currentPage === totalPages;
      nextBtn.addEventListener('click', () => {
        if (currentPage < totalPages) {
          currentPage++;
          applyFilters(true);
        }
      });
      paginationContainer.appendChild(nextBtn);
    }

    function applyFilters(scrollToTop = false) {
      const filtered = getFilteredAndSortedCards();
      const total = filtered.length;

      const totalPages = Math.ceil(total / ITEMS_PER_PAGE);
      if (currentPage > totalPages && totalPages > 0) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = startIndex + ITEMS_PER_PAGE;
      const visibleCards = filtered.slice(startIndex, endIndex);

      allCards.forEach((card) => {
        card.style.display = 'none';
      });

      if (visaGrid) {
        visibleCards.forEach((card) => {
          card.style.display = '';
          visaGrid.appendChild(card);
        });
      }

      if (countBadge) {
        if (total === 0) {
          countBadge.innerText = '0 destinations found';
        } else {
          const from = startIndex + 1;
          const to = Math.min(endIndex, total);
          countBadge.innerText = `Showing ${from}–${to} of ${total} destinations`;
        }
      }

      if (noResults) {
        noResults.classList.toggle('hidden', total > 0);
      }

      renderActiveChips();
      renderPagination(total);

      if (scrollToTop) {
        const anchor = document.getElementById('visa-results-anchor');
        anchor?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Event Listeners
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      searchClear?.classList.toggle('hidden', !searchQuery);
      currentPage = 1;
      applyFilters();
    });

    searchClear?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      searchClear.classList.add('hidden');
      currentPage = 1;
      applyFilters();
    });

    typeSelect?.addEventListener('change', (e) => {
      selectedVisaType = (e.target as HTMLSelectElement).value;
      currentPage = 1;
      applyFilters();
    });

    sortSelect?.addEventListener('change', (e) => {
      selectedSort = (e.target as HTMLSelectElement).value;
      currentPage = 1;
      applyFilters();
    });

    regionPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        selectedRegion = pill.getAttribute('data-region') || 'all';
        syncRegionUI();
        currentPage = 1;
        applyFilters();
      });
    });

    function resetAll() {
      searchQuery = '';
      selectedRegion = 'all';
      selectedVisaType = 'all';
      selectedSort = 'featured';

      if (searchInput) searchInput.value = '';
      searchClear?.classList.add('hidden');
      if (typeSelect) typeSelect.value = 'all';
      if (sortSelect) sortSelect.value = 'featured';

      syncRegionUI();
      currentPage = 1;
      applyFilters();
    }

    resetAllBtn?.addEventListener('click', resetAll);
    emptyResetBtn?.addEventListener('click', resetAll);

    // Initial render
    applyFilters();
  </script>

  <!-- 5-Step Process Section -->
  <section class="section-padding bg-[#10253F] text-white relative overflow-hidden" aria-label="How Our Visa Assistance Works">
    <div class="container-site relative z-10">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-eyebrow block mb-3 text-[#E5C378] font-semibold tracking-widest uppercase text-xs">
