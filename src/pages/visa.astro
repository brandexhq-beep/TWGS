---

<BaseLayout
  title={`Visa Assistance & Global Concierge | ${SITE.name}`}
  description="Fast, reliable, and hassle-free visa services for 50+ countries including Thailand, Bali, Vietnam, Japan, UK, USA, Schengen, and more. 99.2% approval rate."
>
  <!-- Hero Section -->
  <header class="pt-36 pb-20 bg-gradient-to-b from-[#10253F] via-[#0E1E33] to-[#0A1626] text-white relative overflow-hidden">
    <!-- Ambient light circles -->
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-[#C6A34E]/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-[#00277C]/30 rounded-full blur-3xl pointer-events-none"></div>

    <div class="container-site relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-[#E5C378] text-xs font-semibold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 rounded-full bg-[#E5C378]"></span>
          Global Visa Concierge & Assistance
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif text-white mb-6 leading-tight">
          Hassle-Free Visas.<br/>
          <em class="not-italic text-[#E5C378]">Worldwide Approvals.</em>
        </h1>
        
        <p class="text-neutral-300 text-base sm:text-lg max-w-2xl font-light leading-relaxed mb-8">
          Skip the embassy queues and paperwork stress. From instant eVisas to intricate consular submissions, our specialists provide end-to-end documentation audit, fast-track slot booking, and an industry-leading <strong class="text-white font-medium">99.2% approval success rate</strong>.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="#visa-destinations" class="btn btn-primary bg-[#C6A34E] hover:bg-[#B3913E] text-neutral-950 font-semibold px-7 py-3.5 rounded-xl shadow-lg hover:shadow-xl transition-all">
            Explore 25+ Visa Destinations
          </a>
          <a 
            href={`https://wa.me/${SITE.contact.whatsapp}?text=${encodeURIComponent("Hello! I need assistance with getting a visa. Could you please guide me?")}`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn border border-white/30 text-white hover:bg-white/10 px-7 py-3.5 rounded-xl backdrop-blur-sm transition-all flex items-center gap-2"
          >
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>Talk to Visa Specialist</span>
          </a>
        </div>

        <!-- Trust Highlights Strip -->
        <div class="grid grid-cols-3 gap-4 mt-12 pt-8 border-t border-white/10 max-w-xl">
          <div>
            <div class="text-2xl sm:text-3xl font-serif font-bold text-[#E5C378]">99.2%</div>
            <span class="text-xs uppercase tracking-wider text-neutral-300">Approval Rate</span>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-serif font-bold text-[#E5C378]">50+</div>
            <span class="text-xs uppercase tracking-wider text-neutral-300">Countries Supported</span>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-serif font-bold text-[#E5C378]">10k+</div>
            <span class="text-xs uppercase tracking-wider text-neutral-300">Visas Processed</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Popular Visa Countries Section -->
  <section class="section-padding bg-[#FCFCFA]" id="visa-destinations" aria-label="Visa Destinations Concierge">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-eyebrow block mb-3 text-[var(--color-luxury)] font-semibold tracking-widest uppercase text-xs">
          COUNTRIES & DESTINATIONS
        </span>
        <h2 class="text-display-lg text-[var(--color-text-primary)] font-serif">
          Global Visa <em class="not-italic text-[var(--color-accent)] font-serif">Assistance</em>
        </h2>
        <p class="text-[var(--color-text-secondary)] mt-3 text-base">
          Search below to find fast-track tourist eVisas, entry permits, and sticker consular appointments with full checklist verification.
        </p>
      </div>

      <!-- Search & Filter Control Center -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-neutral-200/80 shadow-md mb-10">
        
        <!-- Search Input Bar with Fuzzy Search -->
        <div class="relative mb-6">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-neutral-400">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <input
            type="text"
            id="visa-search-input"
            placeholder="Search countries, destinations, or keywords (e.g. Thailand, Bali, Vietnam, Schengen, Azerbaijan, North Korea, eVisa)..."
            class="w-full pl-12 pr-10 py-3.5 bg-neutral-50 border border-neutral-200 rounded-2xl text-neutral-900 text-sm focus:outline-none focus:ring-2 focus:ring-[#C6A34E] focus:border-transparent transition-all placeholder:text-neutral-400 font-medium"
          />
          <button
            id="visa-search-clear"
            class="absolute inset-y-0 right-0 pr-4 flex items-center text-neutral-400 hover:text-neutral-700 hidden"
            aria-label="Clear search"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Filter Dropdowns Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
          <!-- Visa Type Filter -->
          <div>
            <label for="visa-type-select" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-500 mb-1.5">Visa Category</label>
            <select
              id="visa-type-select"
              class="w-full py-2.5 px-3.5 bg-neutral-50 border border-neutral-200 rounded-xl text-xs font-semibold text-neutral-800 focus:outline-none focus:ring-2 focus:ring-[#C6A34E] focus:border-transparent transition-all"
            >
              <option value="all">All Visa Types</option>
              <option value="evisa">⚡ Instant eVisa / Electronic Permit</option>
              <option value="sticker">🛂 Consular / Sticker / Appointment Visa</option>
              <option value="voa">🛬 Visa on Arrival / Declaration</option>
            </select>
          </div>

          <!-- Sort Filter -->
          <div>
            <label for="visa-sort-select" class="block text-[11px] font-bold uppercase tracking-wider text-neutral-500 mb-1.5">Sort Destinations</label>
            <select
              id="visa-sort-select"
              class="w-full py-2.5 px-3.5 bg-neutral-50 border border-neutral-200 rounded-xl text-xs font-semibold text-neutral-800 focus:outline-none focus:ring-2 focus:ring-[#C6A34E] focus:border-transparent transition-all"
            >
              <option value="featured">Featured / Most Requested First</option>
              <option value="name-asc">Country Name (A to Z)</option>
              <option value="name-desc">Country Name (Z to A)</option>
            </select>
          </div>

          <!-- Reset Filter Button -->
          <div class="flex items-end">
            <button
              id="visa-reset-all-btn"
              class="w-full py-2.5 px-4 bg-neutral-100 hover:bg-neutral-200 text-neutral-700 text-xs font-semibold rounded-xl transition-colors flex items-center justify-center gap-2 border border-neutral-200"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
              </svg>
              <span>Reset All Filters</span>
            </button>
          </div>
        </div>

        <!-- Quick Region Pill Tabs -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none border-t border-neutral-100 pt-5">
          <span class="text-xs font-bold uppercase tracking-wider text-neutral-400 shrink-0 mr-1">Region:</span>
          {regions.map((reg) => (
            <button
              data-region={reg.id}
              class={`visa-region-pill px-4 py-2 rounded-xl text-xs font-bold transition-all shrink-0 cursor-pointer ${
                reg.id === "all"
                  ? "bg-[#10253F] text-white shadow-sm"
                  : "bg-neutral-100 text-neutral-600 hover:bg-neutral-200 hover:text-neutral-900"
              }`}
            >
              {reg.label}
            </button>
          ))}
        </div>

        <!-- Active Search Chips & Result Count -->
        <div class="flex flex-wrap items-center justify-between gap-3 mt-6 pt-5 border-t border-neutral-100 text-xs">
          <div id="visa-active-chips" class="flex flex-wrap items-center gap-2">
            <!-- Dynamically populated -->
          </div>
          <span id="visa-count-badge" class="font-bold text-neutral-500 text-xs shrink-0">
            Showing all {popularVisas.length} destinations
          </span>
        </div>
      </div>

      <!-- Results Anchor -->
      <div id="visa-results-anchor"></div>

      <!-- Visa Grid Container -->
      <div id="visa-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {popularVisas.map((visa, idx) => (
          <div 
            class="visa-card bg-white rounded-3xl p-8 border border-neutral-200/70 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col group relative overflow-hidden"
            data-index={idx}
            data-country={visa.country.toLowerCase()}
            data-coverage={visa.coverage.toLowerCase()}
            data-type-text={visa.type.toLowerCase()}
            data-visa-type={visa.visaType}
            data-region={visa.region}
            data-featured={visa.featured ? "true" : "false"}
            data-highlights={visa.highlights.join(" ").toLowerCase()}
          >
            {visa.featured && (
              <span class="absolute top-0 right-0 bg-[#C6A34E] text-[#10253F] font-bold text-[10px] uppercase tracking-widest px-4 py-1.5 rounded-bl-2xl shadow-sm">
                Most Requested
              </span>
            )}

            <!-- Country Header -->
            <div class="flex items-center gap-3.5 mb-5">
              <span class="text-3xl p-2.5 rounded-2xl bg-neutral-50 border border-neutral-100 shadow-sm">{visa.flag}</span>
              <div>
                <h3 class="text-xl font-serif font-bold text-neutral-900 group-hover:text-[var(--color-accent)] transition-colors">
                  {visa.country}
                </h3>
                <span class="text-xs text-neutral-500 font-medium">{visa.type}</span>
              </div>
