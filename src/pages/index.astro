---
// pages/index.astro — Homepage
import BaseLayout from '../layouts/BaseLayout.astro';
import LoadingScreen from '../components/layout/LoadingScreen.astro';
import PlanTripModal from '../components/layout/PlanTripModal.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import TrustStrip from '../components/sections/TrustStrip.astro';
import FeaturedPackages from '../components/sections/FeaturedPackages.astro';
import ProposalTripsSection from '../components/sections/ProposalTripsSection.astro';
import PopularDestinations from '../components/sections/PopularDestinations.astro';
import PilgrimagePackage from '../components/sections/PilgrimagePackage.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import WhyChooseUs from '../components/sections/WhyChooseUs.astro';
import BlogPreviewSection from '../components/sections/BlogPreviewSection.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import LeadCTABar from '../components/sections/LeadCTABar.astro';
import { SITE } from '../data/site';
import { FAQ_ITEMS } from '../data/faq';
import { getFAQPageSchema } from '../lib/schema';

const canonicalUrl = `${SITE.url}/`;
const faqSchema = getFAQPageSchema(FAQ_ITEMS);
---

<BaseLayout
  title="The Man Wanders Globe | Bespoke Travel & Luxury Packages"
  description="The Man Wanders Globe crafts bespoke domestic and international travel experiences — every stay, transfer, and moment curated so you can simply wander."
  canonicalUrl={canonicalUrl}
  structuredData={faqSchema}
>
  <LoadingScreen />
  <HeroSection />
  <TrustStrip />
  <FeaturedPackages />
  <ProposalTripsSection />
  <PopularDestinations />
  <PilgrimagePackage />
  <ServicesSection />
  <WhyChooseUs />
  <BlogPreviewSection />
  <Testimonials />
  <FAQSection />
  <!-- Floating lead capture bar (slides up on scroll) -->
  <LeadCTABar />
  <!-- Plan My Trip modal (triggered by all #plan-my-trip links) -->
  <PlanTripModal />
</BaseLayout>
