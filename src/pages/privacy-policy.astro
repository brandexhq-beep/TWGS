---
// pages/privacy-policy.astro — DPDP Act 2023 compliant
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const lastUpdated = '1 August 2025'; // TODO: update on final review
---

<BaseLayout
  title={`Privacy Policy | ${SITE.name}`}
  description="Privacy Policy for The Man Wanders Globe — how we collect, use, and protect your personal data in compliance with India's Digital Personal Data Protection Act 2023."
  noIndex={false}
>
  <div class="pt-32 pb-12 bg-[var(--color-accent-secondary)]">
    <div class="container-site">
      <span class="text-eyebrow block mb-4">Legal</span>
      <h1 class="text-display-lg text-white mb-3">Privacy Policy</h1>
      <p class="text-body text-white/60">Last updated: {lastUpdated}</p>
    </div>
  </div>

  <section class="section-padding bg-[var(--color-bg)]">
    <div class="container-site max-w-3xl">
      <div class="legal-prose space-y-10">

        <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 text-sm text-amber-800">
          <strong>⚠️ Client review required before launch:</strong> Confirm your registered legal name, address, CIN/registration number, GST number, and actual data retention periods. Engage a qualified legal professional to review this policy before publishing. This is a good-faith draft based on the DPDP Act 2023 and common travel agency practices.
        </div>

        <div>
          <h2 class="text-h2 mb-4">1. Who We Are</h2>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
            {SITE.company.legalName} ("<strong>The Man Wanders Globe</strong>", "we", "us", "our") is a travel agency registered in India (CIN: {SITE.company.cin}). We operate the website at <a href={SITE.url} class="text-[var(--color-accent)] animated-underline">{SITE.url}</a> and provide travel planning services.
          </p>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed mt-3">
            For privacy-related queries, contact our Privacy Officer at: <a href={`mailto:${SITE.contact.email}`} class="text-[var(--color-accent)] animated-underline">{SITE.contact.email}</a>
          </p>
        </div>

        <div>
          <h2 class="text-h2 mb-4">2. Data We Collect</h2>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed mb-4">When you use our website or services, we may collect:</p>
          <ul class="space-y-2 text-body text-[var(--color-text-secondary)] list-disc list-inside leading-relaxed">
            <li><strong>Identity data:</strong> name, date of birth (where required for bookings)</li>
            <li><strong>Contact data:</strong> email address, phone/WhatsApp number, postal address</li>
            <li><strong>Travel preferences:</strong> destination interests, travel type, budget range, dates</li>
            <li><strong>Technical data:</strong> IP address, browser type, device type, pages visited, time on site (via cookies/analytics, with consent)</li>
            <li><strong>Communications:</strong> messages sent to us via forms, email, or WhatsApp</li>
            <li><strong>Transaction data:</strong> payment amounts and references (we do not store card details — payments processed by PCI-DSS compliant third parties)</li>
          </ul>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed mt-3">
            We do not collect <strong>sensitive personal data</strong> (health, biometric, financial credentials, caste, religion) unless strictly required for a specific booking (e.g. dietary information for a package) and only with your explicit consent.
          </p>
        </div>

        <div>
          <h2 class="text-h2 mb-4">3. Why We Collect Your Data (Purpose & Legal Basis)</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse border border-[var(--color-border)] rounded-xl overflow-hidden">
              <thead>
                <tr class="bg-[var(--color-accent-secondary)] text-white">
                  <th class="p-3 text-left">Purpose</th>
                  <th class="p-3 text-left">Legal Basis (DPDP Act 2023)</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[var(--color-border)]">
                {[
                  ['Respond to your trip enquiry', 'Consent / Contractual necessity'],
                  ['Design and deliver your travel itinerary', 'Performance of a contract'],
                  ['Send you trip confirmation and updates', 'Performance of a contract'],
                  ['Process payments (via third-party processor)', 'Contractual necessity / Legal obligation'],
                  ['Share necessary details with hotels, airlines, transport providers to fulfil your booking', 'Contractual necessity / Legitimate interest'],
                  ['Send marketing emails (travel deals, guides)', 'Consent (opt-in only; you may withdraw at any time)'],
                  ['Improve our website and services', 'Legitimate interest / Consent (analytics cookies)'],
                  ['Comply with legal and regulatory obligations', 'Legal obligation'],
                ].map(([purpose, basis]) => (
                  <tr>
                    <td class="p-3 text-[var(--color-text-primary)]">{purpose}</td>
                    <td class="p-3 text-[var(--color-text-secondary)]">{basis}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div>
          <h2 class="text-h2 mb-4">4. Who We Share Your Data With</h2>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed mb-3">We share your data only where necessary:</p>
          <ul class="space-y-2 text-body text-[var(--color-text-secondary)] list-disc list-inside leading-relaxed">
            <li><strong>Travel partners:</strong> hotels, airlines, ground transport operators, activity providers — only the information needed to complete your booking</li>
            <li><strong>Payment processors:</strong> secure, PCI-DSS compliant payment gateways (e.g. Razorpay, PayU) — we never see your full card number</li>
            <li><strong>Technology partners:</strong> our website host, email service provider, CRM, analytics platform — under data processing agreements</li>
            <li><strong>Legal authorities:</strong> where required by law or a valid court order</li>
          </ul>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed mt-3">
            We do <strong>not</strong> sell, rent or trade your personal data to any third party for their marketing purposes.
          </p>
        </div>

        <div>
          <h2 class="text-h2 mb-4">5. Data Retention</h2>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
            We retain your personal data for as long as necessary to provide our services and comply with legal obligations. As a general guide:
          </p>
          <ul class="space-y-1 text-body text-[var(--color-text-secondary)] list-disc list-inside leading-relaxed mt-3">
            <li>Enquiry and communication records: <strong>3 years</strong> from last contact</li>
            <li>Confirmed booking records: <strong>7 years</strong> (statutory accounting requirements)</li>
            <li>Marketing consent records: until consent is withdrawn + 1 year</li>
            <li>Website analytics (anonymised): <strong>26 months</strong> (or as configured in analytics platform)</li>
          </ul>
        </div>

        <div>
          <h2 class="text-h2 mb-4">6. Your Rights Under the DPDP Act 2023</h2>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed mb-3">
            As a Data Principal under India's Digital Personal Data Protection Act 2023, you have the right to:
          </p>
          <ul class="space-y-2 text-body text-[var(--color-text-secondary)] list-disc list-inside leading-relaxed">
            <li><strong>Access:</strong> request a summary of personal data we hold about you</li>
            <li><strong>Correction:</strong> have inaccurate data corrected</li>
            <li><strong>Erasure:</strong> request deletion of your data (subject to legal retention obligations)</li>
            <li><strong>Withdraw consent:</strong> at any time, without affecting the lawfulness of prior processing</li>
            <li><strong>Grievance redressal:</strong> contact our Privacy Officer (see §1)</li>
            <li><strong>Nominate:</strong> nominate an individual to exercise your rights in the event of your death or incapacity</li>
          </ul>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed mt-3">
            To exercise any right, email us at <a href={`mailto:${SITE.contact.email}`} class="text-[var(--color-accent)] animated-underline">{SITE.contact.email}</a> with the subject "DPDP Rights Request". We will respond within <strong>72 hours</strong>.
          </p>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed mt-2">
            <em>Note: GDPR (EU) and CCPA (California) rights are not addressed here. If you confirm your clients serve EU or California residents, these sections will need to be added.</em>
          </p>
        </div>

        <div>
          <h2 class="text-h2 mb-4">7. Cookies & Tracking</h2>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
            We use cookies for essential website functionality (always on) and, with your consent, for analytics (to understand how visitors use our site). We do not use advertising cookies or sell data to ad networks.
          </p>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed mt-3">
            You can manage cookie preferences at any time via the "<a href="#cookie-preferences" class="text-[var(--color-accent)] animated-underline">Cookie Preferences</a>" link in our footer.
          </p>
        </div>

        <div>
          <h2 class="text-h2 mb-4">8. Security</h2>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
            We implement appropriate technical and organisational measures to protect your data: HTTPS encryption, access controls, regular security reviews, and vendor due diligence. No method of transmission over the internet is 100% secure — if you believe your data has been compromised, contact us immediately.
          </p>
        </div>

        <div>
          <h2 class="text-h2 mb-4">9. Changes to This Policy</h2>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
            We may update this policy from time to time. Material changes will be communicated via email (if you are a registered contact) or a prominent notice on our website. The "Last updated" date at the top indicates when changes were last made.
          </p>
        </div>

        <div>
          <h2 class="text-h2 mb-4">10. Contact & Grievances</h2>
          <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
            For any privacy-related queries, concerns, or to exercise your rights, contact:
          </p>
          <div class="mt-3 p-5 bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)]">
            <p class="font-semibold text-[var(--color-text-primary)]">{SITE.company.legalName}</p>
            <p class="text-body text-[var(--color-text-secondary)]">{SITE.contact.address}</p>
            <p class="text-body text-[var(--color-text-secondary)]">Email: <a href={`mailto:${SITE.contact.email}`} class="text-[var(--color-accent)]">{SITE.contact.email}</a></p>
            <p class="text-body text-[var(--color-text-secondary)]">Phone: <a href={`tel:${SITE.contact.phone}`} class="text-[var(--color-accent)]">{SITE.contact.phone}</a></p>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
