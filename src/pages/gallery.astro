---
// pages/gallery.astro — full masonry gallery with category filters and lightbox
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';

const galleryImages = [
  { src: 'https://images.unsplash.com/photo-1559135197-8a45ea74d367?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1559135197-8a45ea74d367?w=600&q=80', alt: 'Maldives overwater bungalow sunset', category: 'luxury', aspect: '4/3' },
  { src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&q=80', alt: 'Pangong Lake, Ladakh at dawn', category: 'adventure', aspect: '3/4' },
  { src: 'https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=600&q=80', alt: 'Bali rice terrace sunrise', category: 'culture', aspect: '4/3' },
  { src: 'https://images.unsplash.com/photo-1599661046289-e31897846e41?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1599661046289-e31897846e41?w=600&q=80', alt: 'Amber Fort illuminated at night', category: 'culture', aspect: '3/4' },
  { src: 'https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=600&q=80', alt: 'Santorini white domes at sunset', category: 'luxury', aspect: '1/1' },
  { src: 'https://images.unsplash.com/photo-1573843981267-be1999ff37cd?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1573843981267-be1999ff37cd?w=600&q=80', alt: 'Crystal clear Maldives lagoon from above', category: 'beaches', aspect: '4/3' },
  { src: 'https://images.unsplash.com/photo-1502602898657-3e91760cbb34?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1502602898657-3e91760cbb34?w=600&q=80', alt: 'Eiffel Tower through autumn leaves, Paris', category: 'culture', aspect: '3/4' },
  { src: 'https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1602216056096-3b40cc0c9944?w=600&q=80', alt: 'Kerala houseboat on backwaters at dusk', category: 'beaches', aspect: '4/3' },
  { src: 'https://images.unsplash.com/photo-1506461883276-594a12b11cf3?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1506461883276-594a12b11cf3?w=600&q=80', alt: 'Dal Lake, Kashmir at sunrise', category: 'mountains', aspect: '4/3' },
  { src: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&q=80', alt: 'Himalayan mountain range panorama, Himachal', category: 'mountains', aspect: '3/4' },
  { src: 'https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?w=600&q=80', alt: 'Goa beach sunset with silhouettes', category: 'beaches', aspect: '4/3' },
  { src: 'https://images.unsplash.com/photo-1583248369069-9d91f1640fe6?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1583248369069-9d91f1640fe6?w=600&q=80', alt: 'Andaman clear water aerial view', category: 'beaches', aspect: '1/1' },
  { src: 'https://images.unsplash.com/photo-1488085061387-422e29b40080?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1488085061387-422e29b40080?w=600&q=80', alt: 'Solo hiker on mountain ridge at golden hour', category: 'adventure', aspect: '4/3' },
  { src: 'https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=600&q=80', alt: 'Dubai skyline at night with Burj Khalifa', category: 'luxury', aspect: '3/4' },
  { src: 'https://images.unsplash.com/photo-1501854140801-50d01698950b?w=1200&q=85', thumb: 'https://images.unsplash.com/photo-1501854140801-50d01698950b?w=600&q=80', alt: 'Aerial view of forested mountain landscape', category: 'mountains', aspect: '4/3' },
];

const categories = [
  { id: 'all', label: 'All Photos' },
  { id: 'beaches', label: 'Beaches' },
  { id: 'mountains', label: 'Mountains' },
  { id: 'culture', label: 'Culture' },
  { id: 'luxury', label: 'Luxury' },
  { id: 'adventure', label: 'Adventure' },
];
---

<BaseLayout
  title={`Travel Photography Gallery | ${SITE.name}`}
  description="Browse our curated travel photography gallery — beaches, mountains, cultural landmarks, luxury escapes and adventure destinations across India and the world."
  ogImage="https://images.unsplash.com/photo-1573843981267-be1999ff37cd?w=1200&q=85"
>
  <!-- Hero -->
  <div class="pt-32 pb-12 bg-[var(--color-accent-secondary)]">
    <div class="container-site">
      <span class="text-eyebrow block mb-4">Through the Lens</span>
      <h1 class="text-display-xl text-white mb-4">Moments worth<br/><em class="not-italic" style="color: var(--color-luxury);">travelling for.</em></h1>
    </div>
  </div>

  <section class="section-padding bg-[var(--color-bg)]" aria-label="Gallery with category filters">
    <div class="container-site">
      <!-- Filter chips -->
      <div class="flex flex-wrap gap-3 mb-10" role="group" aria-label="Gallery categories">
        {categories.map((cat, i) => (
          <button
            class="chip gallery-filter-btn"
            data-cat={cat.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
            style={i === 0 ? 'border-color: var(--color-accent); color: var(--color-accent); background: rgba(0,39,124,0.06);' : ''}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Masonry gallery -->
      <div id="gallery-masonry" style="columns: 2; column-gap: 1rem;" role="list" aria-label="Gallery images">
        {galleryImages.map((img, i) => (
          <div
            class="gallery-item break-inside-avoid mb-4 cursor-pointer group relative overflow-hidden rounded-xl"
            role="listitem"
            data-cat={img.category}
            data-index={i}
            data-src={img.src}
            data-alt={img.alt}
            tabindex="0"
            aria-label={`Open photo: ${img.alt}`}
          >
            <img
              src={img.thumb}
              alt={img.alt}
              width="600"
              height="400"
              loading="lazy"
              decoding="async"
              class="w-full h-auto object-cover block rounded-xl transition-transform duration-700 group-hover:scale-105"
              style={`aspect-ratio: ${img.aspect};`}
            />
            <!-- Hover overlay -->
            <div class="absolute inset-0 rounded-xl flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
                 style="background: rgba(16,37,63,0.4);" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                <line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
              </svg>
            </div>
          </div>
        ))}
      </div>

      <style>
        @media (min-width: 768px) { #gallery-masonry { columns: 3; } }
        @media (min-width: 1280px) { #gallery-masonry { columns: 4; } }
      </style>
    </div>
  </section>

  <!-- Lightbox -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[--z-modal] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300"
    style="background: rgba(16,37,63,0.95); backdrop-filter: blur(8px);"
    role="dialog"
    aria-label="Photo lightbox"
    aria-modal="true"
  >
    <button id="lb-close" class="absolute top-5 right-5 text-white hover:text-white/70 transition-colors" aria-label="Close lightbox">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <button id="lb-prev" class="absolute left-5 top-1/2 -translate-y-1/2 text-white hover:text-white/70 transition-colors" aria-label="Previous photo">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <button id="lb-next" class="absolute right-5 top-1/2 -translate-y-1/2 text-white hover:text-white/70 transition-colors" aria-label="Next photo">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </button>
    <figure class="max-w-5xl max-h-[85vh] px-16">
      <img id="lb-img" src="" alt="Expanded gallery view" class="max-h-[80vh] max-w-full object-contain rounded-xl transition-opacity duration-300" />
      <figcaption id="lb-caption" class="text-white/60 text-sm text-center mt-4"></figcaption>
    </figure>
  </div>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // ─── Filter ───────────────────────────────────────────────────────────────
  const filterBtns = document.querySelectorAll('.gallery-filter-btn');
  const items = document.querySelectorAll('.gallery-item') as NodeListOf<HTMLElement>;

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.getAttribute('data-cat') ?? 'all';
      filterBtns.forEach(b => {
        b.setAttribute('aria-pressed', 'false');
        (b as HTMLElement).style.cssText = '';
      });
      btn.setAttribute('aria-pressed', 'true');
      (btn as HTMLElement).style.cssText = 'border-color: var(--color-accent); color: var(--color-accent); background: rgba(0,39,124,0.06);';
      items.forEach(item => {
        const show = cat === 'all' || item.getAttribute('data-cat') === cat;
        item.style.display = show ? '' : 'none';
      });
    });
  });

  // ─── Scroll reveal ────────────────────────────────────────────────────────
  gsap.from(items, {
    opacity: 0, duration: 0.4, ease: 'power2.out', stagger: 0.04,
    scrollTrigger: { trigger: '#gallery-masonry', start: 'top 80%' },
  });

  // ─── Lightbox ─────────────────────────────────────────────────────────────
  const lb = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCaption = document.getElementById('lb-caption')!;
  const lbClose = document.getElementById('lb-close')!;
  const lbPrev = document.getElementById('lb-prev')!;
  const lbNext = document.getElementById('lb-next')!;

  const visibleItems = () => Array.from(items).filter(i => i.style.display !== 'none');
  let currentIdx = 0;

  function openLightbox(index: number) {
    const visible = visibleItems();
    currentIdx = index;
    const item = visible[index];
    if (!item) return;
    lbImg.src = item.getAttribute('data-src') ?? '';
    lbImg.alt = item.getAttribute('data-alt') ?? '';
    lbCaption.textContent = item.getAttribute('data-alt') ?? '';
    lb.style.opacity = '1';
    lb.style.pointerEvents = 'auto';
    document.body.style.overflow = 'hidden';
    lbImg.focus();
  }

  function closeLightbox() {
    lb.style.opacity = '0';
    lb.style.pointerEvents = 'none';
    document.body.style.overflow = '';
  }

  items.forEach((item, i) => {
    item.addEventListener('click', () => openLightbox(visibleItems().indexOf(item)));
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(visibleItems().indexOf(item));
      }
    });
  });

  lbClose.addEventListener('click', closeLightbox);
  lbPrev.addEventListener('click', () => { const v = visibleItems(); openLightbox((currentIdx - 1 + v.length) % v.length); });
  lbNext.addEventListener('click', () => { const v = visibleItems(); openLightbox((currentIdx + 1) % v.length); });

  document.addEventListener('keydown', (e) => {
    if (lb.style.opacity !== '1') return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') lbPrev.click();
    if (e.key === 'ArrowRight') lbNext.click();
  });

  lb.addEventListener('click', (e) => { if (e.target === lb) closeLightbox(); });
</script>
