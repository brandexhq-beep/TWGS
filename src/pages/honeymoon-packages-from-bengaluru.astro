---
// pages/honeymoon-packages-from-bengaluru.astro — Niche SEO Landing Page
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { PACKAGES } from '../data/packages';

const honeymoonPackages = PACKAGES.filter((p) => 
  p.category.includes('honeymoon') || p.category.includes('luxury')
);

const canonicalUrl = `${SITE.url}/honeymoon-packages-from-bengaluru`;

const breadcrumb = {
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE.url}/` },
    { "@type": "ListItem", "position": 2, "name": "Honeymoon Packages from Bengaluru", "item": canonicalUrl },
  ]
};

const serviceSchema = {
  "@type": "Service",
  "@id": `${canonicalUrl}#service`,
  "name": "Luxury Honeymoon Packages Departing From Bengaluru",
  "provider": {
    "@type": "TravelAgency",
    "name": SITE.company.brandName,
    "url": SITE.url
  },
  "areaServed": "Bengaluru",
  "description": "Bespoke international & domestic honeymoon packages departing from Kempegowda International Airport (BLR) to Maldives, Bali, Switzerland, Paris & Greece."
};
---

<BaseLayout
  title={`Honeymoon Packages from Bengaluru (2026/2027) | Custom Couples Vacations | ${SITE.name}`}
  description="Discover handpicked luxury honeymoon packages from Bengaluru. Custom itineraries to Maldives, Bali, Switzerland, Paris & Greece with flights from BLR, romantic stays, & 24/7 concierge."
  canonicalUrl={canonicalUrl}
  structuredData={[breadcrumb, serviceSchema]}
>
  <!-- Hero Section -->
  <section class="relative pt-36 pb-20 bg-gradient-to-b from-[#10253F] via-[#0E1E33] to-[#0A1626] text-white overflow-hidden">
    <div class="container-site relative z-10 text-center max-w-4xl mx-auto">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-[#E5C378] text-xs font-bold uppercase tracking-widest mb-6 border border-white/15">
        💖 Handpicked for Couples in Bengaluru
      </span>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif text-white mb-6 leading-tight">
        Luxury Honeymoon Packages<br/>
        <em class="not-italic text-[#E5C378]">Departing From Bengaluru.</em>
      </h1>

      <p class="text-slate-300 text-base sm:text-lg font-light leading-relaxed mb-8 max-w-2xl mx-auto">
        Fly non-stop from Kempegowda International Airport (BLR) to the world's most romantic paradises — overwater villas in Maldives, private pool villas in Bali, and alpine chalets in Switzerland.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a href="#honeymoon-list" class="bg-[#C6A34E] hover:bg-[#B3913E] text-slate-950 font-bold px-8 py-4 rounded-xl text-sm transition-all shadow-xl">
          Browse Bengaluru Honeymoon Packages
        </a>
        <a 
          href={`https://wa.me/${SITE.contact.whatsapp}?text=${encodeURIComponent('Hi! I am looking for a honeymoon package departing from Bengaluru.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-white/30 text-white hover:bg-white/10 px-8 py-4 rounded-xl text-sm font-medium transition-all flex items-center gap-2"
        >
          <span>💬 Instant WhatsApp Quote</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Honeymoon Package Grid -->
  <section id="honeymoon-list" class="py-16 md:py-24 bg-[#F8F8F6]">
    <div class="container-site">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs uppercase font-bold text-[#C6A34E] tracking-widest block mb-2">Curated Itineraries</span>
        <h2 class="text-3xl sm:text-4xl font-serif text-slate-900 font-bold">Top Romantic Destinations from BLR</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {honeymoonPackages.map((pkg) => (
          <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all group">
            <div class="aspect-[16/10] overflow-hidden relative">
              <img src={pkg.heroImage} alt={pkg.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <span class="absolute top-3 right-3 bg-[#00277C] text-white text-[11px] font-bold px-3 py-1 rounded-full">
                {pkg.duration.nights}N / {pkg.duration.days}D
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-bold text-slate-900 text-lg mb-2">{pkg.name}</h3>
              <p class="text-xs text-slate-500 mb-4 line-clamp-2">{pkg.tagline}</p>
              <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                <div>
                  <span class="text-[10px] uppercase text-slate-400 font-bold block">Starting From</span>
                  <span class="text-base font-bold text-[#00277C]">₹{pkg.priceFrom.toLocaleString('en-IN')}</span>
                </div>
                <a href={`/packages/${pkg.slug}`} class="bg-[#C6A34E] hover:bg-[#B3913E] text-slate-950 font-bold px-4 py-2 rounded-xl text-xs transition-all">
                  View Details
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
