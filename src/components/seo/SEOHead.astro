---
// SEOHead.astro — comprehensive meta tags, OG, Twitter Card, robots, canonical
import { SITE } from '../../data/site';
import { getAbsoluteUrl, ROBOTS_DIRECTIVES } from '../../lib/seo';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl: string;
  noIndex?: boolean;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleTags?: string[];
}

const {
  title,
  description,
  ogImage = SITE.ogImage,
  canonicalUrl,
  noIndex = false,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleTags,
} = Astro.props;

const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const absoluteOgImage = getAbsoluteUrl(ogImage);
const robotsContent = noIndex ? ROBOTS_DIRECTIVES.noindex : ROBOTS_DIRECTIVES.default;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />

<!-- Canonical URL: clean without UTM tracking parameters -->
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:secure_url" content={absoluteOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name} — ${description.slice(0, 80)}`} />
<meta property="og:image:type" content="image/webp" />
<meta property="og:locale" content="en_IN" />

{ogType === 'article' && articlePublishedTime && (
  <meta property="article:published_time" content={articlePublishedTime} />
)}
{ogType === 'article' && articleModifiedTime && (
  <meta property="article:modified_time" content={articleModifiedTime} />
)}
{ogType === 'article' && articleAuthor && (
  <meta property="article:author" content={articleAuthor} />
)}
{ogType === 'article' && articleTags && articleTags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@themanwandersglobe" />
<meta name="twitter:creator" content="@themanwandersglobe" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:image:alt" content={`${SITE.name} — ${description.slice(0, 80)}`} />

<!-- Additional Search & Brand Metadata -->
<meta name="author" content={articleAuthor || SITE.name} />
<meta name="theme-color" content="#00277C" />
<meta name="format-detection" content="telephone=no" />
