---
// SectionHeader.astro — eyebrow + display headline + optional subhead
export interface Props {
  eyebrow?: string;
  headline: string;
  subhead?: string;
  align?: 'left' | 'center' | 'right';
  light?: boolean; // for use on dark backgrounds
  id?: string;
}

const {
  eyebrow,
  headline,
  subhead,
  align = 'left',
  light = false,
  id,
} = Astro.props;

const alignClass = {
  left: 'text-left',
  center: 'text-center items-center',
  right: 'text-right items-end',
}[align];
---

<div
  class={`flex flex-col gap-4 ${alignClass} gsap-rise-hidden`}
  id={id}
>
  {eyebrow && (
    <span class="text-eyebrow animated-underline-gold inline-block self-start" style={align === 'center' ? 'align-self: center' : ''}>
      {eyebrow}
    </span>
  )}
  <h2
    class={`text-display-lg ${light ? 'text-white' : 'text-[var(--color-text-primary)]'}`}
    set:html={headline}
  />
  {subhead && (
    <p class={`text-body-lg max-w-2xl ${light ? 'text-white/70' : 'text-[var(--color-text-secondary)]'}`}>
      {subhead}
    </p>
  )}
</div>
