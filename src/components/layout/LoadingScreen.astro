---
// LoadingScreen.astro
// SVG logo draws in via stroke-dashoffset → loading bar fills → curtain-wipe exit
---

<div id="loading-screen" aria-hidden="true" role="presentation">
  <!-- Brand mark SVG — draws stroke-by-stroke -->
  <div class="loading-logo" id="loading-logo">
    <img src="/logo.webp" alt="Loading..." class="loading-logo-img h-20 w-auto object-contain" />
  </div>

  <!-- Loading bar -->
  <div id="loading-bar-track">
    <div id="loading-bar-fill"></div>
  </div>
</div>

<style>
  .loading-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    opacity: 0;
  }

</style>

<script>
  import gsap from 'gsap';

  const screen = document.getElementById('loading-screen');
  const logo = document.getElementById('loading-logo');
  const bar = document.getElementById('loading-bar-fill');



  if (!screen) {
    // No loading screen, skip
  } else {

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReduced) {
      // Skip animation, just hide the screen immediately
      screen.style.display = 'none';
      document.body.classList.add('loaded');
    } else {
      const tl = gsap.timeline({
        onComplete: () => {
          document.body.classList.add('loaded');
        },
      });

      // 1. Fade in logo container
      tl.to(logo, { opacity: 1, duration: 0.3, ease: 'power2.out' });




      // 5. Loading bar fills (simulated)
      tl.to(bar, {
        width: '100%',
        duration: 1.0,
        ease: 'power1.inOut',
      }, '-=0.2');

      // 6. Curtain-wipe exit — clip-path animates UP off screen
      tl.to(screen, {
        clipPath: 'polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)',
        duration: 0.7,
        ease: 'power4.inOut',
        delay: 0.3,
        onStart: () => {
          gsap.set(screen, {
            clipPath: 'polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)',
          });
        },
        onComplete: () => {
          screen.style.display = 'none';
        },
      });
    }
  }
</script>
