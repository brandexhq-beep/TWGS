---
// LoadingScreen.astro
// SVG logo draws in via stroke-dashoffset → loading bar fills → curtain-wipe exit
---

<div id="loading-screen" aria-hidden="true" role="presentation">
  <!-- Brand mark with Water-fill effect -->
  <div class="loading-logo relative" id="loading-logo">
    <img src="/logo.webp" alt="The Man Wanders Globe Logo" class="loading-logo-base w-[250px] md:w-[400px] h-auto object-contain opacity-20 grayscale" />
    <img src="/logo.webp" alt="Loading..." id="loading-logo-fill" class="loading-logo-fill w-[250px] md:w-[400px] h-auto object-contain absolute top-0 left-0" style="clip-path: inset(100% 0 0 0);" />
  </div>
</div>

<style>
  .loading-logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    opacity: 0;
  }

</style>

<script>
  import gsap from 'gsap';

  const screen = document.getElementById('loading-screen');
  const logo = document.getElementById('loading-logo');
  const logoFill = document.getElementById('loading-logo-fill');

  if (!screen) {
    // No loading screen, skip
  } else {

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReduced) {
      // Skip animation, just hide the screen immediately
      screen.style.display = 'none';
      document.body.classList.add('loaded');
    } else {
      const tl = gsap.timeline({
        onComplete: () => {
          document.body.classList.add('loaded');
        },
      });

      // 1. Fade in logo container
      tl.to(logo, { opacity: 1, duration: 0.3, ease: 'power2.out' });

      // 2. Water-fill animation
      if (logoFill) {
        tl.to(logoFill, {
          clipPath: 'inset(0% 0% 0% 0%)',
          duration: 1.2,
          ease: 'power2.inOut',
        });
      }

      // 3. Curtain-wipe exit — clip-path animates UP off screen
      tl.to(screen, {
        clipPath: 'polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)',
        duration: 0.7,
        ease: 'power4.inOut',
        delay: 0.3,
        onStart: () => {
          gsap.set(screen, {
            clipPath: 'polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)',
          });
        },
        onComplete: () => {
          screen.style.display = 'none';
        },
      });
    }
  }
</script>
