---
// Footer.astro — 4-column editorial footer + copyright bar
import { FOOTER_COLUMNS, LEGAL_LINKS } from '../../data/nav';
import { SITE } from '../../data/site';
---

<footer class="site-footer" aria-label="Site footer">
  <!-- Main footer content -->
  <div class="container-site py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">

      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-6" aria-label="Home">
          <img src="/logo.webp" alt="The Man Wanders Globe Logo" class="h-10 w-auto object-contain" />
        </a>
        <p class="text-sm text-white/60 leading-relaxed max-w-xs mb-6">
          Curated journeys, handled entirely. We craft bespoke travel experiences
          that turn destinations into stories.
        </p>
        <!-- Social links -->
        <div class="flex gap-3 flex-wrap">
          <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram"
             class="w-9 h-9 rounded-full flex items-center justify-center border border-white/20 text-white/60 hover:text-white hover:border-white/50 transition-all duration-200">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </a>
          <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook"
             class="w-9 h-9 rounded-full flex items-center justify-center border border-white/20 text-white/60 hover:text-white hover:border-white/50 transition-all duration-200">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
          </a>
          <a href={SITE.social.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube"
             class="w-9 h-9 rounded-full flex items-center justify-center border border-white/20 text-white/60 hover:text-white hover:border-white/50 transition-all duration-200">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58a2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/>
            </svg>
          </a>
          <a href={SITE.social.pinterest} target="_blank" rel="noopener noreferrer" aria-label="Pinterest"
             class="w-9 h-9 rounded-full flex items-center justify-center border border-white/20 text-white/60 hover:text-white hover:border-white/50 transition-all duration-200">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
            </svg>
          </a>
          <a href={`https://wa.me/${SITE.contact.whatsapp}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"
             class="w-9 h-9 rounded-full flex items-center justify-center border border-white/20 text-white/60 hover:text-white hover:border-white/50 transition-all duration-200">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      {FOOTER_COLUMNS.map((col) => (
        <div>
          <h3 class="footer-heading">{col.title}</h3>
          <ul class="space-y-1">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="footer-link animated-underline" style="--color-accent: rgba(255,255,255,0.9)">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Newsletter + contact column -->
      <div>
        <h3 class="footer-heading">Stay Inspired</h3>
        <p class="text-sm text-white/60 mb-4 leading-relaxed">
          Travel stories, destination guides, and exclusive early-bird offers — once a month, never spam.
        </p>
        <form class="flex gap-2 mb-8" id="footer-newsletter" novalidate>
          <input
            type="email"
            placeholder="your@email.com"
            aria-label="Email address for newsletter"
            class="flex-1 px-4 py-2.5 rounded-full text-sm bg-white/10 border border-white/20 text-white placeholder-white/40
                   focus:outline-none focus:border-white/50 focus:bg-white/15 transition-all duration-200 min-h-11"
            required
          />
          <button
            type="submit"
            class="px-4 py-2.5 rounded-full bg-accent text-white text-sm font-semibold
                   hover:bg-accent-dark transition-colors duration-200 shrink-0 min-h-11"
            style="background: var(--color-accent)"
          >
            Subscribe
          </button>
        </form>

        <div class="space-y-2">
          <a href={`tel:${SITE.contact.phone}`}
             class="flex items-center gap-2 text-sm text-white/70 hover:text-white transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            {SITE.contact.phone}
          </a>
          <a href={`tel:${SITE.contact.phoneSecondary}`}
             class="flex items-center gap-2 text-sm text-white/70 hover:text-white transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            {SITE.contact.phoneSecondary}
          </a>
          <a href={`mailto:${SITE.contact.email}`}
             class="flex items-center gap-2 text-sm text-white/70 hover:text-white transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            {SITE.contact.email}
          </a>
          <p class="flex items-start gap-2 text-sm text-white/60">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="mt-0.5 shrink-0" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span>{SITE.contact.address}</span>
          </p>
          <p class="text-xs text-white/40 mt-2">{SITE.contact.businessHours}</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright bar -->
  <div class="border-t border-white/10">
    <div class="container-site py-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex flex-col gap-2">
        <p class="text-xs text-white/40">
          &copy; {new Date().getFullYear()} {SITE.company.legalName}. All rights reserved.
          <span class="block sm:inline sm:ml-2">
            CIN: {SITE.company.cin} &nbsp;|&nbsp; GST: {SITE.company.gstin}
          </span>
        </p>
        <div class="mt-1 flex items-center gap-2">
          <span class="text-[10px] text-white/30 uppercase tracking-widest">Powered by</span>
          <a href="https://www.brandex.co.in/" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity" aria-label="Brandex">
            <img src="/brandex_logo_white_new.webp" alt="Brandex" class="h-5 w-auto object-contain block" />
          </a>
        </div>
      </div>
      <nav class="flex flex-wrap gap-4 justify-center" aria-label="Legal links">
        {LEGAL_LINKS.map((link) => (
          <a
            href={link.href}
            id={link.id}
            class="text-xs text-white/40 hover:text-white/70 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('footer-newsletter') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = form.querySelector('input[type="email"]') as HTMLInputElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    if (!input.value) return;
    btn.textContent = '✓ Subscribed!';
    btn.disabled = true;
    input.value = '';
    setTimeout(() => {
      btn.textContent = 'Subscribe';
      btn.disabled = false;
    }, 4000);
  });
</script>
