---
// Header.astro
// Transparent over hero → solid after 80px scroll (GSAP ScrollTrigger, no scroll listener)
// Mobile: full-screen overlay with staggered link reveal
import { NAV_LINKS } from '../../data/nav';
import { SITE } from '../../data/site';
---

<header id="site-header" class="w-full py-4 px-0">
  <div class="container-site flex items-center justify-between gap-6">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 shrink-0 z-10" aria-label="The Man Wanders Globe — Home">
      <img src="/logo.webp" alt="The Man Wanders Globe Logo" class="h-16 md:h-20 w-auto object-contain py-1" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-6" aria-label="Main navigation">
      {NAV_LINKS.slice(0, 6).map((link) => (
        link.children ? (
          <div class="nav-dropdown-wrapper relative group">
            <a
              href={link.href}
              class="nav-link transition-colors flex items-center gap-1"
              data-nav-link
            >
              {link.label}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="transition-transform duration-200 group-hover:rotate-180" aria-hidden="true">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </a>
            <!-- Dropdown panel -->
            <div class="nav-dropdown absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 translate-y-2 group-hover:translate-y-0 z-50">
              <div class="bg-white rounded-2xl shadow-2xl border border-slate-100 overflow-hidden min-w-[200px]">
                <div class="p-2">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class="flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm text-slate-700 hover:bg-slate-50 hover:text-[var(--color-accent)] transition-all duration-150 font-medium"
                    >
                      {child.label}
                    </a>
                  ))}
                  <div class="border-t border-slate-100 mt-2 pt-2">
                    <a
                      href={link.href}
                      class="flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold text-[var(--color-accent)] hover:bg-[var(--color-accent)]/5 transition-colors"
                    >
                      View All {link.label} →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class="nav-link transition-colors"
            data-nav-link
          >
            {link.label}
          </a>
        )
      ))}
    </nav>

    <!-- CTA + hamburger -->
    <div class="flex items-center gap-4 z-10">
      <a
        href="/#plan-my-trip"
        class="btn btn-primary hidden sm:inline-flex text-sm py-2.5 px-5"
        id="header-cta"
      >
        <span>Plan My Trip</span>
      </a>

      <!-- Hamburger button — mobile -->
      <button
        id="hamburger-btn"
        class="lg:hidden flex flex-col gap-1.5 w-8 h-8 items-center justify-center"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hamburger-line w-6 h-px bg-current block transition-all duration-300 origin-center"></span>
        <span class="hamburger-line w-6 h-px bg-current block transition-all duration-300"></span>
        <span class="hamburger-line w-5 h-px bg-current block transition-all duration-300 origin-center self-end"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile nav overlay -->
<nav
  id="mobile-nav"
  aria-label="Mobile navigation"
  aria-hidden="true"
>
  <!-- Close button -->
  <button
    id="mobile-nav-close"
    class="absolute top-6 right-6 w-10 h-10 flex items-center justify-center text-white"
    aria-label="Close navigation"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <div class="flex flex-col gap-6 py-12">
    {NAV_LINKS.map((link, i) => (
      <a
        href={link.href}
        class="mobile-nav-link animated-underline-gold"
        style={`transition-delay: ${i * 60}ms`}
        onclick="document.getElementById('mobile-nav').classList.remove('open')"
      >
        {link.label}
      </a>
    ))}
    <a
      href="/#plan-my-trip"
      class="btn btn-primary self-start mt-4 mobile-nav-link"
      style={`transition-delay: ${NAV_LINKS.length * 60}ms`}
    >
      <span>Plan My Trip</span>
    </a>
  </div>

  <!-- Contact info at bottom -->
  <div class="absolute bottom-8 left-8 right-8">
    <p class="text-xs tracking-widest uppercase text-white/40 mb-2">Get in touch</p>
    <a href={`tel:${SITE.contact.phone}`} class="text-white/70 hover:text-white text-sm transition-colors">
      {SITE.contact.phone}
    </a>
  </div>
</nav>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const header = document.getElementById('site-header');
  const hamburger = document.getElementById('hamburger-btn');
  const mobileNav = document.getElementById('mobile-nav');
  const mobileClose = document.getElementById('mobile-nav-close');
  const headerCta = document.getElementById('header-cta');
  const navLinks = document.querySelectorAll('[data-nav-link]');
  const lines = document.querySelectorAll('.hamburger-line');

  // ─── Transparent → solid on scroll ───────────────────────────────────────
  // Initial state: transparent (white text for hero overlay)
  if (header) {
    ScrollTrigger.create({
      start: 80,
      onEnter: () => {
        header.classList.add('scrolled');
      },
      onLeaveBack: () => {
        header.classList.remove('scrolled');
      },
    });

    // Mark current page link as active
    navLinks.forEach((link) => {
      const href = (link as HTMLAnchorElement).getAttribute('href');
      if (href && window.location.pathname === href) {
        link.classList.add('active');
      }
    });
  }

  // ─── Mobile nav toggle ────────────────────────────────────────────────────
  function openMobileNav() {
    if (!mobileNav || !hamburger) return;
    mobileNav.classList.add('open');
    mobileNav.setAttribute('aria-hidden', 'false');
    hamburger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';

    // Animate hamburger → X
    gsap.to(lines[0], { rotation: 45, y: 8, duration: 0.3, ease: 'power2.out' });
    gsap.to(lines[1], { opacity: 0, duration: 0.2 });
    gsap.to(lines[2], { rotation: -45, y: -8, width: '1.5rem', duration: 0.3, ease: 'power2.out' });
  }

  function closeMobileNav() {
    if (!mobileNav || !hamburger) return;
    mobileNav.classList.remove('open');
    mobileNav.setAttribute('aria-hidden', 'true');
    hamburger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';

    // Animate X → hamburger
    gsap.to(lines[0], { rotation: 0, y: 0, duration: 0.3, ease: 'power2.out' });
    gsap.to(lines[1], { opacity: 1, duration: 0.2 });
    gsap.to(lines[2], { rotation: 0, y: 0, width: '1.25rem', duration: 0.3, ease: 'power2.out' });
  }

  hamburger?.addEventListener('click', openMobileNav);
  mobileClose?.addEventListener('click', closeMobileNav);

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileNav?.classList.contains('open')) {
      closeMobileNav();
    }
  });
</script>
