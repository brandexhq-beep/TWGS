---
// GalleryPreview.astro — 8-image editorial masonry teaser with blur-up LQIP
import SectionHeader from '../ui/SectionHeader.astro';

const galleryImages = [
  { src: 'https://images.unsplash.com/photo-1559135197-8a45ea74d367?w=800&q=80', alt: 'Maldives overwater bungalow at sunset', aspect: '4/3' },
  { src: 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&q=80', alt: 'Pangong Lake, Ladakh at dawn', aspect: '3/4' },
  { src: 'https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&q=80', alt: 'Bali rice terrace sunrise', aspect: '4/3' },
  { src: 'https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=800&q=80', alt: 'Santorini white domes at sunset', aspect: '1/1' },
];
---

<section class="section-padding bg-[var(--color-bg)]" aria-label="Travel photography gallery preview">
  <div class="container-site">
    <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-6 mb-12">
      <SectionHeader
        eyebrow="Through the Lens"
        headline="Moments worth<br/><em>travelling for.</em>"
        id="gallery-preview-header"
      />
      <a href="/gallery" class="btn btn-secondary shrink-0 self-start lg:self-auto">
        <span>View Full Gallery</span>
      </a>
    </div>

    <!-- Editorial masonry using CSS columns -->
    <div
      class="gallery-masonry"
      style="columns: 2; column-gap: 1rem;"
      role="list"
      aria-label="Gallery preview"
    >
      {galleryImages.map((img, i) => (
        <div
          class="gallery-thumb gsap-hidden break-inside-avoid mb-4 overflow-hidden rounded-xl relative group cursor-pointer"
          role="listitem"
          style={`display: inline-block; width: 100%; margin-bottom: 1rem;`}
          data-index={i}
        >
          <div class="overflow-hidden rounded-xl">
            <img
              src={img.src}
              alt={img.alt}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="w-full h-auto object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              style={`aspect-ratio: ${img.aspect}; display: block;`}
            />
          </div>
          <!-- Hover overlay -->
          <div class="absolute inset-0 rounded-xl bg-[var(--color-accent-secondary)] opacity-0 group-hover:opacity-30 transition-opacity duration-300 pointer-events-none"></div>
        </div>
      ))}
    </div>

    <!-- 3-col from md -->
    <style>
      @media (min-width: 768px) {
        .gallery-masonry { columns: 3; }
      }
    </style>

    <div class="text-center mt-12">
      <a href="/gallery" class="btn btn-primary">
        <span>View All Photos</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const thumbs = document.querySelectorAll('.gallery-thumb');

  gsap.to(thumbs, {
    opacity: 1,
    duration: 0.5,
    ease: 'power2.out',
    stagger: 0.07,
    scrollTrigger: {
      trigger: '.gallery-masonry',
      start: 'top 80%',
    },
  });

  const header = document.getElementById('gallery-preview-header');
  if (header) {
    gsap.to(header, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power3.out',
      scrollTrigger: { trigger: header, start: 'top 80%' },
    });
  }
</script>
