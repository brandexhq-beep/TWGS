---
// FeaturedPackages.astro — compact horizontal cards
import SectionHeader from '../ui/SectionHeader.astro';
import { getFeaturedPackages } from '../../data/packages';

const featured = getFeaturedPackages().slice(0, 3);
---

<section class="pt-[clamp(6rem,12vw,10rem)] pb-12 lg:pb-16 bg-[var(--color-surface)]" aria-label="Featured travel packages">
  <div class="container-site">
    <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-6 mb-10">
      <SectionHeader
        eyebrow="Handpicked Packages"
        headline="Journeys that become <em>stories.</em>"
        subhead="Every package is curated — not templated."
      />
      <a href="/packages" class="btn btn-secondary shrink-0 self-start lg:self-auto">
        <span>View All Packages</span>
      </a>
    </div>

    <!-- Compact 3-column card grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
      {featured.map((pkg) => (
        <article
          class="package-card relative group cursor-pointer flex flex-col gsap-rise-hidden"
          role="listitem"
          aria-label={pkg.name}
        >
          <!-- Stretched link -->
          <a href={`/packages/${pkg.slug}`} class="absolute inset-0 z-10" aria-label={`View details for ${pkg.name}`}></a>
          <!-- Image -->
          <div class="relative overflow-hidden" style="aspect-ratio: 4/3;">
            <img
              src={pkg.heroImage}
              alt={`${pkg.destination} — ${pkg.name}`}
              width="600"
              height="450"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <!-- Duration badge -->
            <div class="absolute top-3 right-3 bg-[var(--color-accent)] text-white text-xs font-semibold px-2.5 py-1 rounded-full">
              {pkg.duration.nights}N/{pkg.duration.days}D
            </div>
          </div>
          <!-- Card body -->
          <div class="p-5 flex flex-col flex-1">
            <p class="text-xs text-[var(--color-text-secondary)] mb-1">{pkg.destination}</p>
            <h3 class="text-base font-semibold leading-snug mb-3" style="font-family: var(--font-display);">{pkg.name}</h3>
            <div class="flex items-center gap-2 mb-4">
              <div class="star-rating" aria-label={`Rated ${pkg.rating} out of 5`}>
                {Array.from({length: 5}).map((_, si) => (
                  <span class="star text-xs" aria-hidden="true">{si < Math.floor(pkg.rating) ? '★' : '☆'}</span>
                ))}
              </div>
              <span class="text-xs text-[var(--color-text-secondary)]">{pkg.rating}</span>
            </div>
            <div class="mt-auto flex items-center justify-between">
              <div>
                <p class="text-xs text-[var(--color-text-secondary)]">From</p>
                <p class="price-tag text-lg">
                  <span class="currency">₹</span>
                  {pkg.priceFrom.toLocaleString('en-IN')}
                </p>
              </div>
              <a href={`/packages/${pkg.slug}`} class="btn btn-primary py-2 px-4 text-xs relative z-20">
                <span>Book Now</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const cards = document.querySelectorAll('.package-card');

  gsap.to(cards, {
    opacity: 1,
    y: 0,
    duration: 0.8,
    ease: 'power3.out',
    stagger: 0.12,
    scrollTrigger: {
      trigger: cards[0],
      start: 'top 80%',
    },
  });
</script>
