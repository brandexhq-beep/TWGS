---
// FeaturedPackages.astro — true bento grid (12-col desktop, asymmetric)
import SectionHeader from '../ui/SectionHeader.astro';
import { getFeaturedPackages } from '../../data/packages';

const featured = getFeaturedPackages();
---

<section class="section-padding bg-[var(--color-surface)]" aria-label="Featured travel packages">
  <div class="container-site">
    <div class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-6 mb-12">
      <SectionHeader
        eyebrow="Handpicked Packages"
        headline="Journeys that become <em>stories.</em>"
        subhead="Every package below is curated — not templated."
      />
      <a href="/packages" class="btn btn-secondary shrink-0 self-start lg:self-auto">
        <span>View All Packages</span>
      </a>
    </div>

    <!-- True bento grid — 12 col desktop -->
    <div class="bento-grid" role="list">
      {featured.map((pkg, i) => (
        <article
          class={`package-card relative group cursor-pointer flex flex-col h-full gsap-rise-hidden bento-package-card ${i === 0 ? 'bento-cell-feature' : 'bento-cell-sm'}`}
          role="listitem"
          aria-label={pkg.name}
        >
          <!-- Stretched link for full card clickability -->
          <a href={`/packages/${pkg.slug}`} class="absolute inset-0 z-10" aria-label={`View details for ${pkg.name}`}></a>
          <!-- Image -->
          <div
            class={`card-image relative overflow-hidden flex-1 ${i === 0 ? '' : ''}`}
            style={i === 0 ? 'aspect-ratio: 16/10;' : 'aspect-ratio: 4/3;'}
          >
            <img
              src={pkg.heroImage}
              alt={`${pkg.destination} — ${pkg.name}`}
              width={i === 0 ? 1200 : 600}
              height={i === 0 ? 750 : 450}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <!-- Category badge -->
            <div class="absolute top-4 left-4 flex gap-2 flex-wrap">
              {pkg.category.slice(0, 2).map((cat) => (
                <span class="chip bg-white/90 border-white text-[var(--color-text-primary)] text-xs py-1 px-3 min-h-0" style="min-height: 0; padding: 0.2rem 0.6rem; font-size: 0.7rem;">
                  {cat.charAt(0).toUpperCase() + cat.slice(1)}
                </span>
              ))}
            </div>
            <!-- Duration badge -->
            <div class="absolute top-4 right-4 bg-[var(--color-accent)] text-white text-xs font-semibold px-3 py-1 rounded-full">
              {pkg.duration.nights}N/{pkg.duration.days}D
            </div>
          </div>

          <!-- Card body -->
          <div class={`p-5 ${i === 0 ? 'lg:p-7' : ''}`}>
            <div class="flex items-start justify-between gap-3 mb-3">
              <div>
                <p class="text-caption text-[var(--color-text-secondary)] mb-0.5">{pkg.destination}</p>
                <h3 class="text-h3 leading-snug">{pkg.name}</h3>
              </div>
              <div class="text-right shrink-0">
                <p class="text-caption text-[var(--color-text-secondary)]">From</p>
                <p class="price-tag text-xl">
                  <span class="currency">₹</span>
                  {pkg.priceFrom.toLocaleString('en-IN')}
                </p>
                <p class="text-caption text-[var(--color-text-secondary)]">per person</p>
              </div>
            </div>

            {/* Highlights — show more on feature card */}
            {i === 0 && (
              <ul class="flex flex-wrap gap-2 mb-5">
                {pkg.highlights.slice(0, 3).map((h) => (
                  <li class="chip" style="min-height: 0; padding: 0.2rem 0.6rem; font-size: 0.7rem;">
                    {h}
                  </li>
                ))}
              </ul>
            )}

            <!-- Rating -->
            <div class="flex items-center gap-2 mb-5">
              <div class="star-rating" aria-label={`Rated ${pkg.rating} out of 5`}>
                {Array.from({length: 5}).map((_, si) => (
                  <span class="star" aria-hidden="true">{si < Math.floor(pkg.rating) ? '★' : '☆'}</span>
                ))}
              </div>
              <span class="text-caption text-[var(--color-text-secondary)]">
                {pkg.rating} ({pkg.reviewCount} reviews)
              </span>
            </div>

            <!-- CTAs -->
            <div class="flex gap-3">
              <a href={`/packages/${pkg.slug}`} class="btn btn-primary flex-1 py-2.5 text-sm">
                <span>Book Now</span>
              </a>
              <button
                class="btn btn-secondary py-2.5 text-sm px-4"
                data-quick-view={pkg.slug}
                aria-label={`Quick view ${pkg.name}`}
              >
                <span>Quick View</span>
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const cards = document.querySelectorAll('.bento-package-card');

  gsap.to(cards, {
    opacity: 1,
    y: 0,
    duration: 1.2,
    ease: 'power4.out',
    stagger: 0.1,
    scrollTrigger: {
      trigger: '.bento-grid',
      start: 'top 75%',
    },
  });
</script>
