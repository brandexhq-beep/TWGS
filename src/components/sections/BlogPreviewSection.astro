---
// BlogPreviewSection.astro — Highlights latest travel guides & insights on the homepage
import SectionHeader from '../ui/SectionHeader.astro';
import { BLOGS } from '../../data/blogs';

const featuredBlogs = BLOGS.slice(0, 3);
---

<section class="section-padding bg-slate-50" aria-label="Travel Insights and Guides">
  <div class="container-site">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <SectionHeader
        eyebrow="Travel Intelligence"
        headline="Guides, Tips & Expert Insights."
        subhead="Everything you need to know before packing your bags — written by our destination specialists."
        id="blog-header"
      />
      <div class="mt-6 md:mt-0">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm font-semibold text-[#00277C] hover:text-[#C6A34E] transition-colors animated-underline"
        >
          View all travel guides
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {featuredBlogs.map((blog) => (
        <article class="bg-white rounded-2xl overflow-hidden border border-slate-200/80 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
          <a href={`/blog/${blog.slug}`} class="block relative aspect-[16/10] overflow-hidden bg-slate-100">
            <img
              src={blog.heroImage}
              alt={blog.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
              width="500"
              height="312"
            />
            <span class="absolute top-4 left-4 bg-white/95 backdrop-blur-md text-[#00277C] text-xs font-bold px-3 py-1 rounded-full shadow-sm">
              {blog.category}
            </span>
          </a>

          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center gap-3 text-xs text-slate-500 mb-2.5">
              <time datetime={blog.publishedDate}>
                {new Date(blog.publishedDate).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
              <span>•</span>
              <span>{blog.readingTime}</span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 group-hover:text-[#00277C] transition-colors leading-snug mb-3">
              <a href={`/blog/${blog.slug}`}>
                {blog.title}
              </a>
            </h3>

            <p class="text-slate-600 text-sm leading-relaxed mb-6 line-clamp-2 flex-1">
              {blog.summary}
            </p>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between mt-auto">
              <span class="text-xs text-slate-500 font-medium">By {blog.author.name}</span>
              <a
                href={`/blog/${blog.slug}`}
                class="text-xs font-semibold text-[#00277C] group-hover:text-[#C6A34E] flex items-center gap-1 transition-colors"
                aria-label={`Read ${blog.title}`}
              >
                Read Guide →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
