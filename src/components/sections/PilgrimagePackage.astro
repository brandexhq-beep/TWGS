---
// components/sections/PilgrimagePackage.astro
import { PACKAGES } from '../../data/packages';

const pilgrimagePackages = PACKAGES.filter(p => p.category.includes('pilgrimage')).slice(0, 3);
---

<section class="py-12 lg:py-16 bg-[#FBFBFA] relative overflow-hidden" id="pilgrimage-packages" aria-label="Spiritual and Pilgrimage Packages">
  <div class="container-site">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div>
        <span class="text-eyebrow block mb-3 text-[#7A5910] font-semibold tracking-widest uppercase text-xs">
          SACRED SANCTUARIES & PILGRIMAGES
        </span>
        <h2 class="text-display-lg text-[var(--color-text-primary)] font-serif">
          Pilgrimage <em class="not-italic text-[var(--color-accent)] font-serif">Packages</em>
        </h2>
        <p class="text-[var(--color-text-secondary)] mt-3 max-w-xl text-base">
          Embark on soul-stirring spiritual journeys with VIP darshan assistance, comfortable stays, and hassle-free guided arrangements.
        </p>
      </div>
      <a href="/packages?category=pilgrimage" class="btn btn-secondary shrink-0 self-start md:self-auto inline-flex items-center gap-2">
        <span>Explore All Pilgrimages</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {pilgrimagePackages.map((pkg) => (
        <article class="group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 bg-neutral-900 flex flex-col h-[460px] cursor-pointer">
          <!-- Background Image -->
          <img 
            src={pkg.heroImage} 
            alt={pkg.name}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
            loading="lazy"
          />

          <!-- Multi-stage Dark Gradient Scrim for guaranteed crystal clear readability -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/50 to-black/20 group-hover:via-black/60 transition-colors duration-300"></div>

          <!-- Top Badges -->
          <div class="relative z-10 p-6 flex justify-between items-start">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase bg-black/40 backdrop-blur-md text-[#E5C378] border border-[#C6A34E]/30">
              <span class="w-1.5 h-1.5 rounded-full bg-[#E5C378]"></span>
              {pkg.duration.nights}N / {pkg.duration.days}D
            </span>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-white/90 text-neutral-900 shadow-sm">
              <span class="text-amber-500">★</span> {pkg.rating}
            </span>
          </div>

          <!-- Bottom Content Area -->
          <div class="relative z-10 mt-auto p-6 flex flex-col">
            <span class="text-xs font-bold tracking-widest uppercase text-[#F3D797] mb-1.5 block drop-shadow-sm">
              {pkg.destination}
            </span>
            
            <h3 class="text-2xl font-serif font-medium text-white mb-2 leading-snug group-hover:text-[#F3D797] transition-colors duration-300 drop-shadow-md">
              {pkg.name}
            </h3>

            <p class="text-xs text-neutral-200 line-clamp-1 mb-4 opacity-90">
              {pkg.tagline}
            </p>

            <div class="pt-4 border-t border-white/15 flex items-center justify-between">
              <div>
                <span class="text-[11px] uppercase tracking-wider text-neutral-300 block">Starting From</span>
                <span class="text-xl font-bold text-white tracking-tight">
                  ₹{pkg.priceFrom.toLocaleString('en-IN')} <span class="text-xs font-normal text-neutral-300">/ person</span>
                </span>
              </div>
              <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/15 backdrop-blur-sm text-white group-hover:bg-[var(--color-luxury)] group-hover:text-neutral-950 transition-all duration-300 group-hover:translate-x-1 shadow-md">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </div>

          <!-- Stretched link for full card clickability -->
          <a href={`/packages/${pkg.slug}`} class="absolute inset-0 z-20" aria-label={`View pilgrimage package ${pkg.name}`}></a>
        </article>
      ))}
    </div>
  </div>
</section>
