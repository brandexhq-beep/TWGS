---
// Testimonials.astro — infinite marquee, animated star ratings, large cards
import { TESTIMONIALS } from '../../data/testimonials';
import SectionHeader from '../ui/SectionHeader.astro';
---

<section class="section-padding bg-[var(--color-surface)] overflow-hidden" aria-label="Customer testimonials">
  <div class="container-site mb-12">
    <SectionHeader
      eyebrow="Traveller Stories"
      headline="5,000+ wanderers.<br/>One thing in common: <em>they came back.</em>"
      align="center"
      id="testimonials-header"
    />
  </div>

  <!-- Marquee wrapper — full width, not contained -->
  <div class="marquee-wrapper" aria-label="Testimonial carousel — auto-scrolling">
    <div class="marquee-track" id="testimonials-track">
      <!-- Render twice for seamless loop -->
      {[...TESTIMONIALS, ...TESTIMONIALS].map((t, i) => (
        <article
          class="testimonial-card shrink-0 w-[340px] sm:w-[400px] bg-[var(--color-bg)] rounded-2xl p-7 border border-[var(--color-border)] flex flex-col gap-4"
          aria-label={`Testimonial by ${t.name}`}
        >
          <!-- Stars -->
          <div class="star-rating" role="img" aria-label={`${t.rating} out of 5 stars`}>
            {Array.from({ length: 5 }).map((_, si) => (
              <span
                class={`star testimonial-star gsap-hidden`}
                style={`transition-delay: ${si * 60}ms`}
                aria-hidden="true"
              >
                ★
              </span>
            ))}
          </div>

          <!-- Quote -->
          <blockquote>
            <p class="text-body text-[var(--color-text-primary)] leading-relaxed line-clamp-5">
              "{t.review}"
            </p>
          </blockquote>

          <!-- Reviewer info -->
          <footer class="flex items-center gap-3 mt-auto pt-4 border-t border-[var(--color-border)]">
            <img
              src={t.avatar}
              alt={`${t.name} profile photo`}
              width="44"
              height="44"
              loading="lazy"
              class="w-11 h-11 rounded-full object-cover"
            />
            <div>
              <p class="font-semibold text-sm text-[var(--color-text-primary)]">{t.name}</p>
              <p class="text-caption text-[var(--color-text-secondary)]">{t.tripTaken} · {t.date}</p>
            </div>
            <!-- Google-style verified icon -->
            <span class="ml-auto flex items-center" role="img" aria-label="Verified Google review" title="Verified review">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
            </span>
          </footer>
        </article>
      ))}
    </div>
  </div>

  <div class="container-site mt-10 text-center">
    <p class="text-caption text-[var(--color-text-secondary)]">
      Read all reviews on
      <a href={`https://g.page/r/themanwandersglobe`} target="_blank" rel="noopener noreferrer"
         class="text-[var(--color-accent)] animated-underline font-medium ml-1">
        Google Maps ↗
      </a>
    </p>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const track = document.getElementById('testimonials-track');

  // Pause marquee on hover
  track?.addEventListener('mouseenter', () => {
    if (track) track.style.animationPlayState = 'paused';
  });
  track?.addEventListener('mouseleave', () => {
    if (track) track.style.animationPlayState = 'running';
  });

  // Pause on touch
  track?.addEventListener('touchstart', () => {
    if (track) track.style.animationPlayState = 'paused';
  }, { passive: true });
  track?.addEventListener('touchend', () => {
    if (track) track.style.animationPlayState = 'running';
  }, { passive: true });

  // Animate stars sequentially when cards enter viewport
  if (!prefersReduced) {
    ScrollTrigger.create({
      trigger: '.marquee-wrapper',
      start: 'top 85%',
      once: true,
      onEnter: () => {
        const stars = document.querySelectorAll('.testimonial-star');
        gsap.to(stars, {
          opacity: 1,
          scale: 1,
          duration: 0.3,
          ease: 'back.out(1.5)',
          stagger: 0.04,
        });
        // Set initial state
        stars.forEach(s => {
          (s as HTMLElement).style.transform = 'scale(0)';
        });
      },
    });
  }

  const header = document.getElementById('testimonials-header');
  if (header) {
    gsap.to(header, {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: 'power3.out',
      scrollTrigger: { trigger: header, start: 'top 80%' },
    });
  }
</script>
