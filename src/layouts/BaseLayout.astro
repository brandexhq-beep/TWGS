---
// BaseLayout.astro — wraps every page
import '../styles/global.css';
import { SITE } from '../data/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ScrollProgress from '../components/layout/ScrollProgress.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import ScrollToTop from '../components/layout/ScrollToTop.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';
import SEOHead from '../components/seo/SEOHead.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
  structuredData?: object | object[];
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  canonicalUrl,
  noIndex = false,
  structuredData,
} = Astro.props;

const pageUrl = canonicalUrl ?? new URL(Astro.url.pathname, SITE.url).toString();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO -->
    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalUrl={pageUrl}
      noIndex={noIndex}
    />

    <!-- Preload critical fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon — brand logo -->
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/logo.webp" />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Playfair Display & Inter -->
    <!-- Organization JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TravelAgency",
      "@id": `${SITE.url}/#organization`,
      "name": SITE.name,
      "alternateName": "TheMan WandersGlobe Tours & Travels",
      "description": SITE.description,
      "url": SITE.url,
      "logo": {
        "@type": "ImageObject",
        "url": `${SITE.url}/logo.webp`,
        "width": 512,
        "height": 512
      },
      "image": `${SITE.url}/logo.webp`,
      "telephone": SITE.contact.phone,
      "email": SITE.contact.email,
      "priceRange": "₹₹-₹₹₹",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Near SBI Road, Chikkagollarahatti, Magadi Main Road",
        "addressLocality": "Bengaluru",
        "addressRegion": "Karnataka",
        "postalCode": "562162",
        "addressCountry": "IN"
      },
      "sameAs": [
        SITE.social.instagram,
        SITE.social.facebook,
        SITE.social.youtube,
        SITE.social.pinterest,
      ],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": String(SITE.stats.averageRating),
        "reviewCount": String(SITE.stats.travellersServed),
        "bestRating": "5",
        "worstRating": "1"
      },
      "openingHours": "Mo-Sa 10:00-19:00"
    })} />

    <!-- Additional page-level structured data -->
    {structuredData && (
      Array.isArray(structuredData)
        ? structuredData.map((sd) => <script type="application/ld+json" set:html={JSON.stringify(sd)} />)
        : <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>

  <body>
    <!-- Scroll progress bar -->
    <ScrollProgress />

    <!-- Site header -->
    <Header />

    <!-- Page content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Floating actions -->
    <WhatsAppButton />
    <ScrollToTop />

    <!-- Cookie consent -->
    <CookieBanner />

    <!-- GSAP & Lenis init -->
    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';

      gsap.registerPlugin(ScrollTrigger);

      // Initialize Lenis
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        direction: 'vertical',
        gestureDirection: 'vertical',
        smooth: true,
        mouseMultiplier: 1,
        smoothTouch: false,
        touchMultiplier: 2,
        infinite: false,
      });

      // Integrate Lenis with GSAP ScrollTrigger
      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      // Make GSAP available globally for island components
      (window as any).__gsap = gsap;
      (window as any).__ScrollTrigger = ScrollTrigger;
    </script>
  </body>
</html>
