---
// BaseLayout.astro — wraps every page
import '../styles/global.css';
import { SITE } from '../data/site';
import LoadingScreen from '../components/layout/LoadingScreen.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ScrollProgress from '../components/layout/ScrollProgress.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import ScrollToTop from '../components/layout/ScrollToTop.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';
import SEOHead from '../components/seo/SEOHead.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
  structuredData?: object;
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  canonicalUrl,
  noIndex = false,
  structuredData,
} = Astro.props;

const pageUrl = canonicalUrl ?? new URL(Astro.url.pathname, SITE.url).toString();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- SEO -->
    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalUrl={pageUrl}
      noIndex={noIndex}
    />

    <!-- Preload critical fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Organization JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TravelAgency",
      "name": SITE.name,
      "description": SITE.description,
      "url": SITE.url,
      "telephone": SITE.contact.phone,
      "email": SITE.contact.email,
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "IN",
        "streetAddress": SITE.contact.address
      },
      "priceRange": "₹₹₹",
      "sameAs": Object.values(SITE.social),
      "openingHours": "Mo-Sa 10:00-19:00"
    })} />

    <!-- Additional page-level structured data -->
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>

  <body>
    <!-- Loading screen (exits before hero reveals) -->
    <LoadingScreen />

    <!-- Scroll progress bar -->
    <ScrollProgress />

    <!-- Site header -->
    <Header />

    <!-- Page content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Floating actions -->
    <WhatsAppButton />
    <ScrollToTop />

    <!-- Cookie consent -->
    <CookieBanner />

    <!-- GSAP init -->
    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      // Make GSAP available globally for island components
      (window as any).__gsap = gsap;
      (window as any).__ScrollTrigger = ScrollTrigger;
    </script>
  </body>
</html>
