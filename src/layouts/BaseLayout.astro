---
// BaseLayout.astro — wraps every page with SEO, Schema.org @graph, and analytics
import '../styles/global.css';
import { SITE } from '../data/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ScrollProgress from '../components/layout/ScrollProgress.astro';
import WhatsAppButton from '../components/layout/WhatsAppButton.astro';
import ScrollToTop from '../components/layout/ScrollToTop.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';
import SEOHead from '../components/seo/SEOHead.astro';
import { getCanonicalUrl } from '../lib/seo';
import { buildSchemaGraph, getWebPageSchema } from '../lib/schema';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
  structuredData?: object | object[];
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleTags?: string[];
  pageType?: string;
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  canonicalUrl,
  noIndex = false,
  structuredData,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleTags,
  pageType = 'WebPage',
} = Astro.props;

// Canonical URL is strictly cleaned of any query params (e.g. ?utm_source=chatgpt.com)
const cleanCanonical = canonicalUrl ?? getCanonicalUrl(Astro.url.pathname);

// Assemble unified Schema.org @graph
const extraSchemas = Array.isArray(structuredData)
  ? structuredData
  : structuredData
  ? [structuredData]
  : [];

// Automatically include the base WebPage schema linked to WebSite & Organization
const defaultWebPageSchema = getWebPageSchema(cleanCanonical, title, description, pageType);
const completeSchemaGraph = buildSchemaGraph([defaultWebPageSchema, ...extraSchemas]);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Technical SEO & Social Tags -->
    <SEOHead
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalUrl={cleanCanonical}
      noIndex={noIndex}
      ogType={ogType}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
      articleAuthor={articleAuthor}
      articleTags={articleTags}
    />

    <!-- Google Tag Manager / GA4 Base Script -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

    <!-- ChatGPT Search Referral Tracking & UTM Handling -->
    <script is:inline>
      (function() {
        try {
          var urlParams = new URLSearchParams(window.location.search);
          var utmSource = urlParams.get('utm_source');
          var utmMedium = urlParams.get('utm_medium');
          var utmCampaign = urlParams.get('utm_campaign');
          var referrer = document.referrer || '';
          
          var isChatGPTReferral = (utmSource && utmSource.toLowerCase() === 'chatgpt.com') ||
                                  referrer.indexOf('chatgpt.com') !== -1;

          if (isChatGPTReferral) {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: 'chatgpt_search_referral',
              traffic_source: 'chatgpt.com',
              utm_source: utmSource || 'chatgpt.com',
              utm_medium: utmMedium || 'referral',
              utm_campaign: utmCampaign || 'chatgpt_search',
              referrer: referrer,
              landing_page: window.location.pathname
            });

            if (typeof window.gtag === 'function') {
              window.gtag('event', 'chatgpt_search_referral', {
                event_category: 'AI Search Referral',
                event_label: window.location.pathname,
                source: 'chatgpt.com',
                page_path: window.location.pathname
              });
            }
          }
        } catch (e) {
          // Non-blocking fail-safe
        }
      })();
    </script>

    <!-- Preload critical fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon & PWA Icons -->
    <link rel="icon" type="image/webp" href="/logo.webp?v=2" />
    <link rel="apple-touch-icon" href="/logo.webp?v=2" />
    <meta name="application-name" content={SITE.name} />
    <meta name="apple-mobile-web-app-title" content={SITE.name} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="generator" content={Astro.generator} />

    <!-- Unified Schema.org @graph (TravelAgency, WebSite, WebPage, Breadcrumbs, Entity data) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(completeSchemaGraph)} />
  </head>

  <body>
    <!-- Accessibility skip link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-[#00277C] focus:text-white focus:px-4 focus:py-2 focus:rounded-md">
      Skip to main content
    </a>

    <!-- Scroll progress bar -->
    <ScrollProgress />

    <!-- Site header -->
    <Header />

    <!-- Page content -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- Floating actions -->
    <WhatsAppButton />
    <ScrollToTop />

    <!-- Cookie consent -->
    <CookieBanner />

    <!-- GSAP & Lenis init -->
    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from 'lenis';

      gsap.registerPlugin(ScrollTrigger);

      // Initialize Lenis
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      });

      // Integrate Lenis with GSAP ScrollTrigger
      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      // Make GSAP available globally for island components
      (window as any).__gsap = gsap;
      (window as any).__ScrollTrigger = ScrollTrigger;
    </script>
  </body>
</html>
